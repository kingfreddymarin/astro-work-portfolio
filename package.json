{
  "name": "fjml-studio-monorepo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "astro build && playwright test",
    "test:mobile": "astro build && playwright test --project=mobile-320 --project=mobile-375 --project=pixel-5",
    "test:desktop": "astro build && playwright test --project=desktop",
    "dev:portfolio": "cd apps/portfolio-nextjs && npm run dev",
    "dev:dashboard": "cd apps/dashboard-remix && npm run dev",
    "build:portfolio": "cd apps/portfolio-nextjs && npm run build",
    "build:dashboard": "cd apps/dashboard-remix && npm run build",
    "build:all": "pnpm -r build",
    "deploy": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:all": "firebase deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.2.1",
    "astro": "^4.15.0"
  }
}

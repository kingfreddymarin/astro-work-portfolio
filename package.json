{
  "name": "fjml-studio-monorepo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:astro": "cd apps/legacy-astro && astro dev",
    "dev:portfolio": "cd apps/portfolio-nextjs && npm run dev",
    "dev:dashboard": "cd apps/dashboard-remix && npm run dev",
    "build:astro": "cd apps/legacy-astro && astro build",
    "build:portfolio": "cd apps/portfolio-nextjs && npm run build",
    "build:dashboard": "cd apps/dashboard-remix && npm run build",
    "build:all": "pnpm -r build",
    "deploy": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:all": "firebase deploy"
  },
  "devDependencies": {}
}

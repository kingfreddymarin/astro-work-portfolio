rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Lead capture from the public inquiry form.
    // Visitors may CREATE a lead; users may read their own leads.
    match /leads/{leadId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
      allow create: if isValidLead(request.resource.data);
    }

    // User-specific saved build configurations.
    match /builds/{buildId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Publicly shared build configurations.
    match /shared_builds/{buildId} {
      allow read: if true;
      allow create: if request.resource.data.get('userId', null) == null || (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Studio Knowledge app — private, single-owner Notion-style pages.
    // Each page is strictly scoped to its owner; nothing is shared/public.
    match /kb_pages/{pageId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    // Everything else is locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidLead(data) {
    return data.keys().hasOnly([
             'name', 'email', 'company', 'service', 'package',
             'message', 'source', 'createdAt', 'userAgent', 'pageUrl', 'userId',
             'specialRequest', 'specialEvidence'
           ])
      && data.name is string    && data.name.size() > 0    && data.name.size() <= 120
      && data.email is string   && data.email.size() > 3    && data.email.size() <= 200
      && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
      && data.message is string && data.message.size() > 0  && data.message.size() <= 4000
      && data.company is string && data.company.size() <= 200
      && data['service'] is string && data['service'].size() <= 80
      && data['package'] is string && data['package'].size() <= 80
      && data.source is string  && data.source.size() <= 40
      && data.createdAt == request.time
      && (data.get('userId', null) == null || (data.userId is string && (request.auth == null || data.userId == request.auth.uid)))
      && (data.get('specialRequest', null) == null || data.specialRequest is bool)
      && (data.get('specialEvidence', null) == null || (data.specialEvidence is string && data.specialEvidence.size() <= 4000));
  }
}

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main id="views" class="views">
    <div class="view is-active" data-view="home"><Hero /></div>
    <div class="view" data-view="about"><About /></div>
    <div class="view" data-view="work"><Projects /></div>
    <div class="view" data-view="skills"><Skills /></div>
    <div class="view" data-view="contact">
      <Contact />
      <Footer />
    </div>
  </main>
</Layout>

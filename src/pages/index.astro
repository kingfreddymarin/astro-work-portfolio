---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import CaseScene from '../components/CaseScene.astro';
import CasaBlancaScene from '../components/CasaBlancaScene.astro';
import SimReachScene from '../components/SimReachScene.astro';
import Services from '../components/Services.astro';
import Configurator from '../components/Configurator.astro';
import Skills from '../components/Skills.astro';
import Styleguide from '../components/Styleguide.astro';
import Contact from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main id="views" class="views">
    <div class="view is-active" data-view="home"><Hero /></div>
    <div class="view" data-view="about"><About /><FAQ /></div>
    <div class="view" data-view="work"><Projects /></div>
    <div class="view" data-view="services"><Services /><Configurator /></div>
    <div class="view" data-view="skills"><Skills /></div>
    <div class="view" data-view="styles"><Styleguide /></div>
    <div class="view" data-view="contact">
      <Contact />
      <Footer />
    </div>
  </main>
  <!-- full-screen case overlays live outside the views so they're never display:none -->
  <CaseScene />
  <CasaBlancaScene />
  <SimReachScene />
</Layout>

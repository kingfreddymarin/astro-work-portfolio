---
import { skills, strategicMultipliers } from '../data/portfolio.js';
const domainCount = String(skills.length).padStart(2, '0');
---

<section id="skills">
  <div class="section-header reveal">
    <span class="section-number">04</span>
    <h2 class="section-title">Expertise & Velocity</h2>
    <span class="telemetry" aria-hidden="true">
      <span>INTEGRATION_CAPACITY // ANY_STACK_ANY_TIME</span><span class="caret"></span>
    </span>
  </div>

  <div class="adaptability-banner reveal">
    <span class="console-label">SYSTEM_INDEX // ADAPTABILITY_COEFFICIENT</span>
    <div class="index-row">
      <div class="index-item">
        <span class="index-val">0.03s</span>
        <span class="index-label">CONTEXT_SWITCH</span>
      </div>
      <div class="index-item">
        <span class="index-val">100%</span>
        <span class="index-label">STACK_AGNOSTIC</span>
      </div>
      <div class="index-item">
        <span class="index-val">HIGH</span>
        <span class="index-label">RAMP_VELOCITY</span>
      </div>
    </div>
  </div>

  <div class="skills-wrapper">
    <div class="skills-main-grid">
      <!-- Left: Strategic Growth (The Meaning) -->
      <div class="strategic-column reveal">
        <div class="console-header">
          <span class="label">CORE_EVOLUTION // LAST_12_MONTHS</span>
        </div>
        <div class="multiplier-list">
          {strategicMultipliers.map((m, i) => (
            <div class="multiplier-item">
              <span class="m-index">0{i + 1}</span>
              <h3 class="m-title">{m.title}</h3>
              <p class="m-desc">{m.description}</p>
              <div class="m-impact">
                <span class="impact-label">KPI_IMPACT:</span>
                <span class="impact-value">{m.impact}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Technical Arsenal (The Foundation) -->
      <div class="technical-column reveal">
        <div class="console-header">
          <span class="label">TECHNICAL_ARSENAL // {domainCount}_DOMAINS</span>
        </div>
        <div class="tech-matrix">
          {skills.map(({ category, items }, i) => (
            <div class="tech-category">
              <span class="cat-title">{category}</span>
              <ul class="cat-list">
                {items.map(item => (
                  <li><span class="dot"></span>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #skills {
    padding: 6rem 5vw 5rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  .skills-wrapper {
    margin-top: 1rem;
    width: 100%;
  }

  /* ── Adaptability Banner ── */
  .adaptability-banner {
    border: 1px solid var(--border);
    background: rgba(var(--border-rgb), 0.05);
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .index-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
  }
  .index-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .index-val {
    font-family: 'DM Mono', monospace;
    font-size: 18px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .index-label {
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    color: var(--ink-3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .skills-main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: stretch;
  }

  /* ── Console Header (Shared) ── */
  .console-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--border);
    border-bottom: 1px solid var(--border);
  }
  .console-header .label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--ink-2);
    text-transform: uppercase;
  }

  /* ── Strategic Column (Meaning) ── */
  .strategic-column {
    border: 1px solid var(--border);
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }
  .multiplier-list {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    flex: 1;
  }
  .multiplier-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }
  .m-index {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    position: absolute;
    left: -2rem;
    top: 0.25rem;
  }
  .m-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
  }
  .m-desc {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 45ch;
  }
  .m-impact {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .impact-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    color: var(--ink-3);
  }
  .impact-value {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  /* ── Technical Column (Foundation) ── */
  .technical-column {
    border: 1px solid var(--border);
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }
  .tech-matrix {
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    flex: 1;
  }
  .tech-category {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cat-title {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .cat-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .cat-list li {
    font-size: 13px;
    color: var(--ink-2);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .dot {
    width: 4px;
    height: 4px;
    background: var(--border);
    border-radius: 50%;
  }
  .tech-category:hover .dot {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  @media (max-width: 1100px) {
    .skills-main-grid { gap: 2rem; }
    .multiplier-list { padding: 2.5rem; }
    .tech-matrix { gap: 2rem; }
  }

  @media (max-width: 900px) {
    .skills-main-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .m-index { position: static; margin-bottom: 0.5rem; }
    #skills { min-height: auto; }
  }

  @media (max-width: 600px) {
    .adaptability-banner { padding: 1.25rem 1.25rem; }
    .index-row {
      gap: 1.25rem 1.5rem;
      justify-content: space-between;
    }
    .index-val { font-size: 16px; }
  }

  @media (max-width: 480px) {
    .tech-matrix { grid-template-columns: 1fr; }
  }
</style>

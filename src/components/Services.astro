---
import { services } from '../data/portfolio.js';
---

<section id="services">
  <div class="section-header reveal">
    <span class="section-number">04</span>
    <h2 class="section-title">Services</h2>
    <span class="telemetry" aria-hidden="true">
      <span>SOFTWARE_SOLUTIONS // V1.0</span><span class="caret"></span>
    </span>
  </div>

  <div class="services-container">
    <!-- The Services section is the "Design your build" experience. Clicking
         anywhere on the panel opens the configurator overlay (Configurator.astro
         listens for [data-open-configurator]). -->
    <button class="builder-launch reveal" type="button" data-open-configurator>
      <div class="builder-launch-head">
        <span class="builder-eyebrow">[+] BUILD CONFIGURATOR</span>
        <h3 class="builder-title">Design your build</h3>
        <p class="builder-lede">
          Not sure what you need? Configure your software step by step and watch
          the investment take shape as it grows in capability.
        </p>
      </div>

      <div class="builder-areas">
        <span class="builder-areas-label">WHAT WE BUILD //</span>
        <ul class="builder-area-list">
          {services.map((service) => (
            <li class="builder-area">
              <span class="builder-area-index">[{service.index}]</span>
              <span class="builder-area-name">{service.title}</span>
            </li>
          ))}
        </ul>
      </div>

      <span class="builder-cta">
        <span class="builder-cta-text">CONFIGURE YOUR SOLUTION</span>
        <span class="builder-cta-arrow" aria-hidden="true">→</span>
      </span>
    </button>
  </div>
</section>

<style>
  #services {
    padding: 6rem 5vw 5rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .section-header {
    margin-bottom: 0.5rem;
  }

  .services-container {
    margin-top: 1rem;
    position: relative;
    flex: 1;
    display: flex;
  }

  /* ── Builder launch panel (the whole Services section) ── */
  .builder-launch {
    width: 100%;
    text-align: left;
    color: inherit;
    cursor: pointer;
    background: linear-gradient(180deg, var(--accent-dim) 0%, var(--bg) 55%);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: clamp(2.5rem, 5vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
    transition: border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .builder-launch:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 24px 60px -30px var(--accent);
  }

  .builder-eyebrow {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .builder-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }
  .builder-lede {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--ink-2);
    max-width: 60ch;
    line-height: 1.6;
  }

  .builder-areas {
    border-top: 1px solid var(--border);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .builder-areas-label {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
  }
  .builder-area-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem 2.5rem;
  }
  .builder-area {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .builder-area-index {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    flex-shrink: 0;
  }
  .builder-area-name {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.1;
  }

  .builder-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    align-self: flex-start;
    background: var(--ink);
    color: var(--bg);
    padding: 1.25rem 2rem;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--radius);
    transition: background 0.4s cubic-bezier(0.19, 1, 0.22, 1),
      padding 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .builder-launch:hover .builder-cta {
    background: var(--accent);
    padding-right: 3rem;
  }
  .builder-cta-arrow {
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .builder-launch:hover .builder-cta-arrow {
    transform: translateX(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .builder-launch, .builder-cta, .builder-cta-arrow { transition: none; }
    .builder-launch:hover { transform: none; }
  }

  @media (max-width: 768px) {
    .builder-cta { align-self: stretch; }
  }
</style>

---
/*
  FJML Signal Frame — the brand mark.
  Single source of truth for the inline logo (Nav, IntroLoader, Footer …).
  The favicon lives separately at public/favicon.svg (must be a static file).
  Monogram is set in bold Georgia (web-safe serif) so it renders thick and
  identical everywhere — including the file-referenced favicon — without
  depending on a loaded webfont.
*/
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 32, class: cls = '', title = 'FJML Studio' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 512 512"
  fill="none"
  class={`brand-mark ${cls}`}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
>
  <rect width="512" height="512" rx="72" fill="#0E0F11" />
  <g stroke="#FFC24B" stroke-width="20" stroke-linecap="square">
    <path d="M88 168V88H168" />
    <path d="M344 88H424V168" />
    <path d="M424 344V424H344" />
    <path d="M168 424H88V344" />
  </g>
  <g fill="#ECEEF0" font-family="Georgia, 'Times New Roman', serif" font-size="132" font-weight="700">
    <text x="143" y="234">FJ</text>
    <text x="143" y="370">ML</text>
  </g>
  <rect x="386" y="246" width="20" height="20" fill="#FFC24B" />
</svg>

<style>
  .brand-mark { display: block; }
</style>

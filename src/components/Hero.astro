---
import { site } from '../data/portfolio.js';
---

<section id="hero">
  <p class="hero-label">{site.title}</p>
  <h1 class="hero-name">
    {site.heroHeadline.prefix}<br />
    <em>{site.heroHeadline.highlight}</em><span class="cursor" aria-hidden="true"></span>
  </h1>
  <p class="hero-tagline">{site.tagline}</p>
  <div class="hero-cta">
    <a class="btn btn-primary" href="#projects">View my work</a>
    <a class="btn btn-ghost" href="#contact">Get in touch</a>
  </div>
  {site.available && (
    <p class="hero-available">
      <span class="dot" aria-hidden="true"></span>
      Available for new opportunities
    </p>
  )}
  <p class="hero-scroll" aria-hidden="true">Scroll to explore</p>
</section>

<style>
  #hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8rem 5vw 6rem;
    position: relative;
  }

  .hero-label {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s 0.2s ease forwards;
  }

  .hero-name {
    font-family: 'Cormorant Garant', serif;
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
    opacity: 0;
    animation: fadeUp 0.7s 0.35s ease forwards;
  }
  .hero-name em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 0.75em;
    background: var(--accent);
    margin-left: 4px;
    vertical-align: middle;
    animation: blink 1.1s step-end infinite;
  }

  .hero-tagline {
    margin-top: 2rem;
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--ink-2);
    max-width: 440px;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s 0.5s ease forwards;
  }

  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    opacity: 0;
    animation: fadeUp 0.7s 0.65s ease forwards;
  }

  .hero-available {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    opacity: 0;
    animation: fadeUp 0.7s 0.75s ease forwards;
  }
  .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #3DAB6A;
    animation: pulse 2s ease infinite;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem; left: 5vw;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: fadeUp 0.7s 1s ease forwards;
  }
  .hero-scroll::before {
    content: '';
    display: block;
    width: 40px; height: 1px;
    background: var(--ink-3);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.3); }
  }
</style>

---
import { site } from '../data/portfolio.js';
---

<section id="hero">
  <div class="hero-blob" aria-hidden="true"></div>
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <p class="hero-label">{site.studio} // {site.discipline}</p>
    <h1 class="hero-name">
      {site.heroHeadline.prefix}<br />
      <em>{site.heroHeadline.highlight}</em><span class="cursor" aria-hidden="true"></span>
    </h1>
    <p class="hero-tagline">{site.tagline}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#projects">View our work</a>
      <a class="btn btn-ghost" href="#contact">Get in touch</a>
    </div>
    {site.available && (
      <p class="hero-available">
        <span class="dot" aria-hidden="true"></span>
        Available for new engagements
      </p>
    )}
  </div>
  <button class="hero-scroll" type="button" data-open-menu aria-label="Open menu to explore">Press [M] to open Menu</button>
  <span class="hero-style-hint" aria-hidden="true">✦ shift aesthetic</span>
</section>

<style>
  #hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8rem 5vw 6rem;
    position: relative;
    overflow: hidden;
  }

  /* ── Ambient blob ── */
  .hero-blob {
    position: absolute;
    width: 640px;
    height: 640px;
    top: 0; left: 0;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(255, 194, 75, 0.09) 0%, transparent 68%);
    filter: blur(70px);
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-label {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s 0.2s ease forwards;
  }

  .hero-name {
    font-family: 'Fraunces', serif;
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
    opacity: 0;
    animation: fadeUp 0.7s 0.35s ease forwards;
  }
  .hero-name em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
    animation: glow 3.5s ease-in-out infinite;
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 0.75em;
    background: var(--accent);
    margin-left: 4px;
    vertical-align: middle;
    animation: blink 1.1s step-end infinite;
  }

  .hero-tagline {
    margin-top: 2rem;
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--ink-2);
    max-width: 440px;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.7s 0.5s ease forwards;
  }

  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    opacity: 0;
    animation: fadeUp 0.7s 0.65s ease forwards;
  }

  .hero-available {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    opacity: 0;
    animation: fadeUp 0.7s 0.75s ease forwards;
  }
  .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #3DAB6A;
    animation: pulse 2s ease infinite;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem; left: 5vw;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: fadeUp 0.7s 1s ease forwards;
    z-index: 2;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.2s;
  }
  .hero-scroll:hover { color: var(--accent); }
  .hero-scroll:hover::before { background: var(--accent); }
  .hero-scroll::before {
    content: '';
    display: block;
    width: 40px; height: 1px;
    background: var(--ink-3);
  }

  .hero-style-hint {
    position: absolute;
    bottom: 2rem; right: 5vw;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    opacity: 0;
    animation: fadeUp 0.7s 1.3s ease forwards;
    z-index: 1;
    user-select: none;
    transition: color 0.2s ease;
  }
  .hero-style-hint:hover {
    color: var(--accent);
  }
  /* Strict mode locks the brand — no aesthetic shifting offered. */
  html[data-strict] .hero-style-hint { display: none; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(1.3); }
  }

  /* ══ Mobile hero — title leads, description becomes a mono caption ══ */
  @media (max-width: 768px) {
    #hero { padding: 7rem 7vw 5.5rem; justify-content: center; }

    .hero-label { font-size: 11px; margin-bottom: 1.25rem; }

    /* Big, dominant title */
    .hero-name {
      font-size: clamp(3.25rem, 18vw, 6rem);
      line-height: 0.9;
      letter-spacing: -0.03em;
    }
    .cursor { width: 4px; }

    /* Description repositioned as a tight, on-brand mono caption */
    .hero-tagline {
      margin-top: 1.75rem;
      max-width: 32ch;
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      line-height: 1.7;
      letter-spacing: 0.04em;
      color: var(--ink-3);
      padding-left: 0.9rem;
      border-left: 1px solid var(--accent);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Full-width stacked CTAs */
    .hero-cta {
      margin-top: 2.25rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .hero-cta .btn { justify-content: center; padding: 0.95rem 1.5rem; }

    .hero-available { margin-top: 1.5rem; }
    .hero-scroll, .hero-style-hint { font-size: 10px; }
  }

  /* Very small phones — drop the caption entirely, let the title own the screen */
  @media (max-width: 420px) {
    .hero-name { font-size: clamp(3rem, 19vw, 5rem); }
    .hero-tagline { display: none; }
  }
</style>

<!-- Node network + shockwave ripple (Canvas 2D — no external deps) -->
<script>
const canvas = document.getElementById('hero-canvas');
if (canvas instanceof HTMLCanvasElement) {
  const ctx = canvas.getContext('2d')!;

  let W = 0, H = 0;
  function resize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();

  const isMobile = window.matchMedia('(pointer: coarse)').matches;
  const reduce   = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const COUNT    = isMobile ? 28 : 55;
  const CDIST2   = (isMobile ? 160 : 200) ** 2;

  const px  = new Float32Array(COUNT);
  const py  = new Float32Array(COUNT);
  const vx  = new Float32Array(COUNT);
  const vy  = new Float32Array(COUNT);
  const bvx = new Float32Array(COUNT);
  const bvy = new Float32Array(COUNT);

  for (let i = 0; i < COUNT; i++) {
    px[i] = Math.random() * W;
    py[i] = Math.random() * H;
    bvx[i] = vx[i] = (Math.random() - 0.5) * 0.5;
    bvy[i] = vy[i] = (Math.random() - 0.5) * 0.35;
  }

  type Ripple = { x: number; y: number; r: number; s: number };
  const ripples: Ripple[] = [];

  let mnx = 0.5, mny = 0.5;
  let parallaxX = 0, parallaxY = 0;
  let scrollOff = 0;
  let blobX = W / 2, blobY = H / 2, blobTX = W / 2, blobTY = H / 2;
  const blob = document.querySelector<HTMLElement>('.hero-blob');

  window.addEventListener('mousemove', (e: MouseEvent) => {
    mnx = e.clientX / W;
    mny = e.clientY / H;
    blobTX = e.clientX;
    blobTY = e.clientY;
  });

  window.addEventListener('scroll', () => { scrollOff = window.scrollY; }, { passive: true });

  document.getElementById('hero')?.addEventListener('click', (e: Event) => {
    const ev = e as MouseEvent;
    ripples.push({ x: ev.clientX, y: ev.clientY, r: 0, s: 3 });
  });

  // Blob lerp — desktop only
  if (!isMobile && blob) {
    (function blobRAF() {
      if (!document.hidden) {
        blobX += (blobTX - blobX) * 0.04;
        blobY += (blobTY - blobY) * 0.04;
        blob.style.transform = `translate(${blobX - 320}px, ${blobY - 320}px)`;
      }
      requestAnimationFrame(blobRAF);
    })();
  }

  let heroVisible = true;
  document.addEventListener('visibilitychange', () => { heroVisible = !document.hidden; });
  new IntersectionObserver(entries => {
    heroVisible = entries[0].isIntersecting && !document.hidden;
  }, { threshold: 0 }).observe(canvas);

  function tick() {
    requestAnimationFrame(tick);
    if (!heroVisible || reduce) return;

    ctx.clearRect(0, 0, W, H);

    parallaxX += ((mnx - 0.5) * 24 - parallaxX) * 0.04;
    parallaxY += ((mny - 0.5) * 16 - parallaxY) * 0.04;
    const ox = isMobile ? 0 : parallaxX;
    const oy = (isMobile ? 0 : parallaxY) - scrollOff * 0.03;

    for (let i = 0; i < COUNT; i++) {
      px[i] += vx[i];
      py[i] += vy[i];
      if (px[i] < -20) px[i] = W + 20;
      if (px[i] > W + 20) px[i] = -20;
      if (py[i] < -20) py[i] = H + 20;
      if (py[i] > H + 20) py[i] = -20;
      vx[i] += (bvx[i] - vx[i]) * 0.022;
      vy[i] += (bvy[i] - vy[i]) * 0.022;
    }

    for (let ri = ripples.length - 1; ri >= 0; ri--) {
      const rp = ripples[ri];
      rp.r += 8; rp.s *= 0.965;
      for (let i = 0; i < COUNT; i++) {
        const dx = px[i] - rp.x, dy = py[i] - rp.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 0.1) continue;
        const wave = Math.max(0, 1 - Math.abs(dist - rp.r) / 40);
        if (wave > 0) { const f = wave * rp.s * 0.5; vx[i] += (dx / dist) * f; vy[i] += (dy / dist) * f; }
      }
      if (rp.r > Math.max(W, H) || rp.s < 0.04) ripples.splice(ri, 1);
    }

    // Connections — one batched path
    ctx.beginPath();
    for (let i = 0; i < COUNT; i++) {
      for (let j = i + 1; j < COUNT; j++) {
        const dx = px[i] - px[j], dy = py[i] - py[j];
        if (dx * dx + dy * dy < CDIST2) {
          ctx.moveTo(px[i] + ox, py[i] + oy);
          ctx.lineTo(px[j] + ox, py[j] + oy);
        }
      }
    }
    ctx.strokeStyle = 'rgba(255,194,75,0.12)';
    ctx.lineWidth = 1;
    ctx.stroke();

    // Particles — one batched path
    ctx.beginPath();
    for (let i = 0; i < COUNT; i++) {
      ctx.moveTo(px[i] + ox + 2.5, py[i] + oy);
      ctx.arc(px[i] + ox, py[i] + oy, 2.5, 0, Math.PI * 2);
    }
    ctx.fillStyle = 'rgba(255,194,75,0.7)';
    ctx.fill();
  }

  tick();

  window.addEventListener('resize', () => {
    resize();
    for (let i = 0; i < COUNT; i++) {
      if (px[i] > W) px[i] = Math.random() * W;
      if (py[i] > H) py[i] = Math.random() * H;
    }
  }, { passive: true });
}
</script>

<!-- Style theme cycling — click hero to shift aesthetic -->
<script>
  const STYLES = ['', 'glass', 'chaos', 'terminal', 'winxp'] as const;
  const HINTS  = ['✦ shift aesthetic', '✦ go chaotic', '✦ restore sanity', '✦ enter the matrix', '✦ activate luna'] as const;

  const current = (document.documentElement.getAttribute('data-style') ?? '') as typeof STYLES[number];
  let styleIdx = Math.max(0, STYLES.indexOf(current));

  const hint = document.querySelector<HTMLElement>('.hero-style-hint');
  if (hint) hint.textContent = HINTS[styleIdx];

  function cycleStyle() {
    // Strict mode locks the default brand — no aesthetic shifting.
    if (document.documentElement.hasAttribute('data-strict')) return;
    styleIdx = (styleIdx + 1) % STYLES.length;
    const style = STYLES[styleIdx];

    document.documentElement.setAttribute('data-transitioning', '');

    if (style) {
      document.documentElement.setAttribute('data-style', style);
      localStorage.setItem('site-style', style);
    } else {
      document.documentElement.removeAttribute('data-style');
      localStorage.removeItem('site-style');
    }

    if (hint) hint.textContent = HINTS[styleIdx];

    setTimeout(() => document.documentElement.removeAttribute('data-transitioning'), 500);
  }

  // Exposed for any external trigger (e.g. Ctrl+, handler) to shift the aesthetic.
  (window as any).cycleStyle = cycleStyle;

  hint?.addEventListener('click', (e) => {
    e.stopPropagation();
    cycleStyle();
  });

  // Change theme/aesthetic: Ctrl + ,
  window.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key === ',') {
      e.preventDefault();
      cycleStyle();
    }
  });
</script>

<!-- Text scramble on load + re-scramble on hover + chromatic glitch -->
<script>
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%!?&';

  function scramble(el: HTMLElement, delay = 0, duration = 600) {
    const original = el.textContent ?? '';
    setTimeout(() => {
      const t0 = performance.now();
      (function tick(now: number) {
        const p = Math.min((now - t0) / duration, 1);
        el.textContent = original.split('').map((ch, i) => {
          if (ch === ' ' || ch === '\n') return ch;
          if (i / original.length < p) return ch;
          return CHARS[Math.floor(Math.random() * CHARS.length)];
        }).join('');
        if (p < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = original;
          el.animate(
            [{ transform:'scale(1)' }, { transform:'scale(1.015)' }, { transform:'scale(1)' }],
            { duration: 180, easing: 'ease-out' }
          );
        }
      })(performance.now());
    }, delay);
  }

  const label  = document.querySelector<HTMLElement>('.hero-label');
  const heroEm = document.querySelector<HTMLElement>('.hero-name em');

  if (label)  scramble(label,  200, 800);
  if (heroEm) scramble(heroEm, 420, 650);

  let reScrambleCooldown = false;
  document.querySelector('.hero-name')?.addEventListener('mouseenter', () => {
    if (reScrambleCooldown || !heroEm) return;
    reScrambleCooldown = true;
    scramble(heroEm, 0, 320);
    setTimeout(() => { reScrambleCooldown = false; }, 900);
  });

  /* Chromatic aberration glitch — fires every 5–11s */
  const heroName = document.querySelector<HTMLElement>('.hero-name');
  function triggerGlitch() {
    if (!heroName) return;
    heroName.animate(
      [
        { textShadow: 'none',       filter: 'none'           },
        { textShadow: '-4px 0 rgba(255,30,30,0.7), 4px 0 rgba(30,30,255,0.7)', filter: 'blur(0.4px)' },
        { textShadow: '4px 0 rgba(255,30,30,0.7), -4px 0 rgba(30,30,255,0.7)', filter: 'none'         },
        { textShadow: '-2px 0 rgba(255,30,30,0.5), 2px 0 rgba(30,30,255,0.5)', filter: 'blur(0.2px)' },
        { textShadow: 'none',       filter: 'none'           },
      ],
      { duration: 350, easing: 'steps(4)' }
    ).finished.then(() => setTimeout(triggerGlitch, 5000 + Math.random() * 6000));
  }
  setTimeout(triggerGlitch, 4500);
</script>

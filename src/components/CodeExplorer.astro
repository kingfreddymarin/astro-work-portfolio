---
---

<div class="resource-explorer reveal" style="margin-top: 3.5rem;">
  <aside class="files-tree">
    <div class="tree-title">SYS_BLUEPRINTS // FILES</div>
    <div class="tree-nodes" id="file-tree-nodes">
      <button class="file-node is-active" data-file="telemetry.rs" type="button">
        <span class="file-icon">🦀</span>
        <span class="file-name">telemetry.rs</span>
      </button>
      <button class="file-node" data-file="mcp_client.py" type="button">
        <span class="file-icon">🐍</span>
        <span class="file-name">mcp_client.py</span>
      </button>
      <button class="file-node" data-file="applet.java" type="button">
        <span class="file-icon">☕</span>
        <span class="file-name">applet.java</span>
      </button>
    </div>
  </aside>

  <div class="code-viewer-panel">
    <nav class="code-tabs" id="code-tab-nav">
      <button class="code-tab-btn is-active" data-tab="Source" type="button">Source</button>
      <button class="code-tab-btn" data-tab="Config" type="button">Config</button>
      <button class="code-tab-btn" data-tab="Specs" type="button">Specs</button>
    </nav>

    <div class="code-container">
      <button class="code-copy-btn" id="btn-copy-code" type="button">COPY</button>
      <pre class="code-line-numbers"><div class="line-nums" id="code-line-nums"></div><div class="code-lines" id="code-lines-content"></div></pre>
    </div>
  </div>
</div>

<script>
  // File explorer registry and state managers
  const FILE_REGISTRY: Record<string, { tabs: Record<string, string> }> = {
    'telemetry.rs': {
      tabs: {
        'Source': `// Telemetry node checker - FJML Studio v1.0
use std::time::{SystemTime, UNIX_EPOCH};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let now = SystemTime::now().duration_since(UNIX_EPOCH)?;
    println!("[SYS_TELEMETRY] Status: Nominal at {}", now.as_secs());
    
    let nodes = vec!["auth_node", "database_secure", "mcp_gateway"];
    for node in nodes {
        check_pulse(node)?;
    }
    Ok(())
}

fn check_pulse(node: &str) -> Result<(), &'static str> {
    println!("  -> Pinging {} ... OK (12ms)", node);
    Ok(())
}`,
        'Config': `[package]
name = "fjml-telemetry"
version = "1.0.0"
edition = "2021"

[dependencies]
tokio = { version = "1.30", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }`,
        'Specs': `# Telemetry Spec Matrix
Unified pulse check diagnostic utility.
Emits telemetry status packets over TLS 1.3 to FJML command servers.

- Ping Interval: 120s
- Auth Token: HS256 JWT
- SSL Mode: Pin-Strict`
      }
    },
    'mcp_client.py': {
      tabs: {
        'Source': `# Model Context Protocol Gateway Client
import asyncio
from mcp import ClientSession, StdioServerParameters

async def run_mcp_session():
    params = StdioServerParameters(command="agy", args=["mcp", "start"])
    async with ClientSession(params) as session:
        # Query active tools
        tools = await session.list_tools()
        print(f"[MCP_INIT] Loaded {len(tools)} server tools.")
        
        # Invoke codebase search tool
        res = await session.call_tool("grep_search", {"Query": "TODO"})
        print(f"Matches found: {res.content}")

if __name__ == "__main__":
    asyncio.run(run_mcp_session())`,
        'Config': `[tool.poetry]
name = "mcp-gateway"
version = "0.1.0"
description = "FJML Studio MCP integration"
authors = ["FJML Studio <studio@fjml.com>"]

[tool.poetry.dependencies]
python = "^3.10"
mcp = "^0.4.2"`,
        'Specs': `{
  "$schema": "https://modelcontextprotocol.io/schema/v2024/mcp.json",
  "client": {
    "name": "FJML Core Client",
    "version": "1.0.0"
  },
  "capabilities": {
    "roots": true,
    "sampling": {}
  }
}`
      }
    },
    'applet.java': {
      tabs: {
        'Source': `package studio.fjml.sim;

import javacard.framework.*;
import javacard.security.*;

public class FjmlApplet extends Applet {
    private static final byte CLA_FJML = (byte) 0xB0;
    private static final byte INS_SIGN = (byte) 0x20;
    
    public static void install(byte[] bArray, short bOffset, byte bLength) {
        new FjmlApplet().register();
    }
    
    public void process(APDU apdu) {
        if (selectingApplet()) return;
        byte[] buffer = apdu.getBuffer();
        if (buffer[ISO7816.OFFSET_CLA] != CLA_FJML) {
            ISOException.throwIt(ISO7816.SW_CLA_NOT_SUPPORTED);
        }
        // Secure cryptography operations
        if (buffer[ISO7816.OFFSET_INS] == INS_SIGN) {
            apdu.setOutgoingAndSend((short)0, (short)16);
        }
    }`,
        'Config': `<applet-descriptor>
  <aid>A000000018464A4D4C01</aid>
  <version>1.2.0</version>
  <card-profile>
    <gp-version>2.3.1</gp-version>
    <java-card-version>3.0.4</java-card-version>
  </card-profile>
</applet-descriptor>`,
        'Specs': `# Embedded Telecom Applet Specs
Card Application Toolkit secure channel configuration.

- Cipher suite: AES-CBC-128 / HMAC-SHA256
- Keys loaded at personalization stage:
  - Ki (KIC / KID) derivation
  - OTA transport over SMS (PP-SMS)`
      }
    }
  };

  let activeFile = 'telemetry.rs';
  let activeTab = 'Source';

  const lineNumsEl = document.getElementById('code-line-nums');
  const codeContentEl = document.getElementById('code-lines-content');
  const btnCopy = document.getElementById('btn-copy-code');
  const fileNodes = document.querySelectorAll('#file-tree-nodes .file-node');
  const tabBtns = document.querySelectorAll('#code-tab-nav .code-tab-btn');

  function renderActiveCode() {
    const fileData = FILE_REGISTRY[activeFile];
    if (!fileData) return;

    const rawCode = fileData.tabs[activeTab] || '';
    
    if (codeContentEl) {
      codeContentEl.textContent = rawCode;
    }

    if (lineNumsEl) {
      const linesCount = rawCode.split('\n').length;
      let numsHtml = '';
      for (let i = 1; i <= linesCount; i++) {
        numsHtml += `${i}\n`;
      }
      lineNumsEl.textContent = numsHtml;
    }
  }

  fileNodes.forEach(node => {
    node.addEventListener('click', () => {
      fileNodes.forEach(n => n.classList.remove('is-active'));
      node.classList.add('is-active');
      activeFile = node.getAttribute('data-file') || 'telemetry.rs';
      renderActiveCode();
    });
  });

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeTab = btn.getAttribute('data-tab') || 'Source';
      renderActiveCode();
    });
  });

  btnCopy?.addEventListener('click', async () => {
    const fileData = FILE_REGISTRY[activeFile];
    if (!fileData) return;
    const rawCode = fileData.tabs[activeTab] || '';

    try {
      await navigator.clipboard.writeText(rawCode);
      const prevText = btnCopy.textContent;
      btnCopy.textContent = 'COPIED';
      btnCopy.style.borderColor = 'var(--trace)';
      btnCopy.style.color = 'var(--trace)';
      setTimeout(() => {
        btnCopy.textContent = prevText;
        btnCopy.style.borderColor = '';
        btnCopy.style.color = '';
      }, 1500);
    } catch (err) {
      console.error('[clipboard] Failed to copy code:', err);
    }
  });

  // Initial render
  renderActiveCode();
</script>

---
import { about, site } from '../data/portfolio.js';
const metricCount = String(about.stats.length).padStart(2, '0');
---

<section id="about">
  <div class="section-header reveal">
    <span class="section-number">02</span>
    <h2 class="section-title">About</h2>
    <span class="telemetry" aria-hidden="true">
      <span>STUDIO // {site.studio.toUpperCase()}</span><span class="caret"></span>
    </span>
  </div>

  <div class="about-wrapper">
    <div class="about-main-layout">
      <!-- Left: Large Editorial Bio -->
      <div class="bio-column reveal">
        <div class="console-header">
          <span class="label">BIOGRAPHICAL // DATA_STREAM</span>
        </div>
        <div class="bio-content">
          {about.bio.map((paragraph, i) => (
            <p class={`bio-para para-${i}`} set:html={paragraph} />
          ))}
        </div>
        <div class="bio-footer">
          <div class="meta-item">
            <span class="meta-label">STATUS</span>
            <span class="meta-value">{site.available ? 'AVAILABLE_FOR_ENGAGEMENT' : 'ON_NDA_ASSIGNMENT'}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">COORDINATES</span>
            <span class="meta-value">{site.location}</span>
          </div>
        </div>
      </div>

      <!-- Right: Technical Stats & Identity -->
      <div class="stats-column reveal">
        <div class="stats-grid">
          {about.stats.map(({ number, label }, i) => (
            <div class="stat-card">
              <span class="stat-index">[{String(i + 1).padStart(2, '0')}]</span>
              <span class="stat-number stat-number">{number}</span>
              <span class="stat-label">{label}</span>
            </div>
          ))}
        </div>

        <div class="identity-panel">
          <div class="console-header">
            <span class="label">IDENTITY // VERIFICATION</span>
          </div>
          <div class="id-content">
            <div class="id-row">
              <span class="id-label">STUDIO</span>
              <span class="id-value">{site.studio}</span>
            </div>
            <div class="id-row">
              <span class="id-label">RANGE</span>
              <span class="id-value">SIM_TO_AI_AGENTS</span>
            </div>
            <div class="id-row">
              <span class="id-label">RAMP_UP</span>
              <span class="id-value">EXTREME_VELOCITY</span>
            </div>
          </div>
          <button class="faq-trigger" type="button" data-open-faq aria-haspopup="dialog" aria-controls="faq-modal">
            <span class="faq-trigger-label">FREQUENT QUERIES</span>
            <span class="faq-trigger-arrow" aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #about {
    padding: calc(var(--nav-h) + 2rem) var(--edge-pad) 5rem;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    border-bottom: 1px solid var(--border);
  }

  .section-header {
    margin-bottom: 1rem;
  }

  .about-wrapper {
    margin-top: 2rem;
    width: 100%;
  }

  .about-main-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: stretch;
  }

  /* ── Console Header (Shared) ── */
  .console-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--border);
    border-bottom: 1px solid var(--border);
  }
  .console-header .label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--ink-2);
    text-transform: uppercase;
  }

  /* ── Bio Column ── */
  .bio-column {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .bio-content {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: 1;
  }
  .bio-para {
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-2);
  }
  .bio-para :global(strong) {
    color: var(--accent);
    font-weight: 500;
  }
  .para-0 {
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .bio-footer {
    display: flex;
    border-top: 1px solid var(--border);
    background: rgba(var(--border-rgb), 0.1);
  }
  .meta-item {
    flex: 1;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-right: 1px solid var(--border);
  }
  .meta-item:last-child { border-right: none; }
  .meta-label {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .meta-value {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--ink-2);
  }

  /* ── Stats & ID Column ── */
  .stats-column {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid var(--border);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    flex: 1;
  }
  .stat-card {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: all 0.4s ease;
  }
  .stat-card:nth-child(2n) { border-right: none; }
  .stat-card:hover {
    background: rgba(var(--border-rgb), 0.1);
  }
  .stat-index {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .stat-number {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 600;
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .stat-label {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .identity-panel {
    border: 1px solid var(--border);
    border-top: none;
    border-left: none;
  }
  .id-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .id-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }
  .id-row:last-child { border-bottom: none; }
  .id-label {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    color: var(--ink-3);
  }
  .id-value {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--ink-2);
  }

  /* FAQ modal trigger */
  .faq-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.9rem 1.5rem;
    background: none;
    border: none;
    border-top: 1px solid var(--border);
    color: var(--ink-2);
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .faq-trigger:hover {
    color: var(--accent);
    background: var(--accent-dim);
  }
  .faq-trigger-arrow {
    color: var(--accent);
    transition: transform 0.25s;
  }
  .faq-trigger:hover .faq-trigger-arrow { transform: translate(2px, -2px); }

  @media (max-width: 1100px) {
    .about-main-layout { gap: 2rem; }
    .bio-content { padding: 2rem; }
  }

  @media (max-width: 900px) {
    .about-main-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    /* min-height was deliberately NOT re-declared here: the view scroller in
       global.css relies on min-height:0, and overriding it broke mobile scrolling. */
    #about { padding: 4rem var(--edge-pad) 8rem; }
    .stats-column { border-left: none; border-top: 1px solid var(--border); }
  }

  @media (max-width: 480px) {
    .bio-content { padding: 2rem 1.5rem; }
    .stats-grid { grid-template-columns: 1fr; }
    .bio-footer { flex-direction: column; }
    .meta-item { border-right: none; border-bottom: 1px solid var(--border); }
  }
</style>

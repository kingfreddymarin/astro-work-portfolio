---
import { site } from '../data/portfolio.js';
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---

<footer>
  <span class="footer-brand">
    <BrandMark size={20} />
    © {year} {site.studio}
  </span>
  <span>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></span>
</footer>

<style>
  footer {
    padding: 1rem var(--edge-pad) 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  footer a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.2s;
  }
  footer a:hover { color: var(--accent); }
</style>

---
import { faq } from '../data/portfolio.js';
import Accordion from './Accordion.astro';
---

<div class="faq-modal" id="faq-modal" hidden>
  <div class="faq-backdrop" data-close-faq aria-hidden="true"></div>
  <div class="faq-dialog" role="dialog" aria-modal="true" aria-labelledby="faq-title">
    <div class="faq-head">
      <span class="faq-kicker">SUPPORT // FREQUENT QUERIES</span>
      <button class="faq-close" type="button" data-close-faq>CLOSE [×]</button>
    </div>

    <div class="faq-body">
      <h2 id="faq-title" class="faq-heading">Questions, answered.</h2>

      <Accordion items={faq} />
    </div>
  </div>
</div>

<style>
  /* ── Modal shell (mirrors the inquiry modal) ── */
  .faq-modal {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .faq-modal[hidden] { display: none; }

  .faq-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 9, 10, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: faq-backdrop-fade 0.35s ease;
  }
  @keyframes faq-backdrop-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .faq-dialog {
    position: relative;
    width: min(680px, 100%);
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    border: 1px solid var(--border-2);
    background: var(--surface);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
    animation: faq-dialog-rise 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes faq-dialog-rise {
    from { opacity: 0; transform: translateY(18px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .faq-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .faq-kicker {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }
  .faq-close {
    background: none;
    border: none;
    color: var(--ink-3);
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: color 0.2s;
  }
  .faq-close:hover { color: var(--accent); }

  .faq-body {
    padding: 1.75rem 1.75rem 1.5rem;
  }
  .faq-heading {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }

  /* ── Accordion ── */
  .faq-list {
    border-top: 1px solid var(--border);
  }
  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-q {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 0.15rem;
    cursor: pointer;
    list-style: none;
  }
  .faq-q::-webkit-details-marker { display: none; }

  .faq-no {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    transition: color 0.25s;
  }
  .faq-q-text {
    font-family: 'Fraunces', serif;
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  @media (hover: hover) {
    .faq-q:hover .faq-no { color: var(--accent); }
    .faq-q:hover .faq-q-text { color: var(--accent); }
  }
  .faq-item[open] .faq-no { color: var(--accent); }

  .faq-icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .faq-icon-h,
  .faq-icon-v {
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--ink-2);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s;
  }
  .faq-icon-h { width: 14px; height: 1.5px; }
  .faq-icon-v { width: 1.5px; height: 14px; }
  .faq-item[open] .faq-icon-v { transform: scaleY(0); }
  .faq-item[open] .faq-icon-h { background: var(--accent); }

  .faq-a {
    padding: 0 0.15rem 1.4rem 3.75rem;
  }
  .faq-a p {
    max-width: 64ch;
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--ink-2);
  }
  .faq-item[open] .faq-a {
    animation: faq-reveal 0.4s ease;
  }
  @keyframes faq-reveal {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-backdrop,
    .faq-dialog,
    .faq-item[open] .faq-a { animation: none; }
    .faq-icon-h, .faq-icon-v { transition: none; }
  }

  @media (max-width: 768px) {
    .faq-modal { padding: 0; }
    .faq-dialog { max-height: 100vh; height: 100%; width: 100%; }
    .faq-q { grid-template-columns: 2rem 1fr auto; gap: 0.75rem; }
    .faq-a { padding-left: 2.75rem; }
  }
</style>

<script>
  const modal = document.getElementById('faq-modal') as HTMLElement | null;

  if (modal) {
    const openFAQ = () => {
      modal.hidden = false;
      document.body.classList.add('overlay-active');
      modal.querySelector<HTMLButtonElement>('.faq-close')?.focus();
    };
    const closeFAQ = () => {
      modal.hidden = true;
      document.body.classList.remove('overlay-active');
      
      // Collapse all accordion items so it opens clean next time
      modal.querySelectorAll('.accordion-trigger.is-active').forEach((t) => {
        const trigger = t as HTMLButtonElement;
        trigger.classList.remove('is-active');
        trigger.setAttribute('aria-expanded', 'false');
        const content = trigger.nextElementSibling as HTMLElement;
        if (content) {
          content.style.maxHeight = '0px';
          content.classList.remove('is-open');
        }
      });
    };

    document.querySelectorAll('[data-open-faq]').forEach((el) =>
      el.addEventListener('click', (e) => { e.preventDefault(); openFAQ(); })
    );
    modal.querySelectorAll('[data-close-faq]').forEach((el) =>
      el.addEventListener('click', closeFAQ)
    );
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeFAQ();
    });

  }
</script>

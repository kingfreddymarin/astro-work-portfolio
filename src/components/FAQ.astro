---
import { faq } from '../data/portfolio.js';
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="faq-inner">
    <div class="faq-head">
      <span class="faq-kicker">SUPPORT // FREQUENT QUERIES</span>
      <h2 id="faq-title" class="faq-title">Questions, answered.</h2>
    </div>

    <div class="faq-list">
      {faq.map((item, i) => (
        <details class="faq-item" name="faq">
          <summary class="faq-q">
            <span class="faq-no">[{String(i + 1).padStart(2, '0')}]</span>
            <span class="faq-q-text">{item.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <span class="faq-icon-h"></span>
              <span class="faq-icon-v"></span>
            </span>
          </summary>
          <div class="faq-a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 5rem 5vw 4rem;
    border-top: 1px solid var(--border);
  }
  .faq-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .faq-head {
    margin-bottom: 2.5rem;
  }
  .faq-kicker {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }
  .faq-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .faq-list {
    border-top: 1px solid var(--border);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  /* summary row */
  .faq-q {
    display: grid;
    grid-template-columns: 3.25rem 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 0.25rem;
    cursor: pointer;
    list-style: none;
    transition: color 0.25s;
  }
  .faq-q::-webkit-details-marker { display: none; }

  .faq-no {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    transition: color 0.25s;
  }
  .faq-q-text {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.05rem, 2.2vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  @media (hover: hover) {
    .faq-q:hover .faq-no { color: var(--accent); }
    .faq-q:hover .faq-q-text { color: var(--accent); }
  }
  .faq-item[open] .faq-no { color: var(--accent); }

  /* plus → minus icon */
  .faq-icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .faq-icon-h,
  .faq-icon-v {
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--ink-2);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s;
  }
  .faq-icon-h { width: 14px; height: 1.5px; }
  .faq-icon-v { width: 1.5px; height: 14px; }
  .faq-item[open] .faq-icon-v { transform: scaleY(0); }
  .faq-item[open] .faq-icon-h { background: var(--accent); }

  /* answer */
  .faq-a {
    padding: 0 0.25rem 1.6rem 4.5rem;
  }
  .faq-a p {
    max-width: 70ch;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--ink-2);
  }
  .faq-item[open] .faq-a {
    animation: faq-reveal 0.4s ease;
  }
  @keyframes faq-reveal {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon-h, .faq-icon-v { transition: none; }
    .faq-item[open] .faq-a { animation: none; }
  }

  @media (max-width: 768px) {
    .faq-q {
      grid-template-columns: 2rem 1fr auto;
      gap: 0.75rem;
    }
    .faq-a { padding-left: 2.75rem; }
  }
</style>

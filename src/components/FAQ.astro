---
import { faq } from '../data/portfolio.js';
import Accordion from './Accordion.astro';
import Sheet from './Sheet.astro';
---

<Sheet id="faq-sheet" eyebrow="SUPPORT // FREQUENT QUERIES">
  <div class="faq-body">
    <h2 id="faq-title" class="faq-heading">Questions, answered.</h2>
    <Accordion items={faq} />
  </div>
</Sheet>

<style>
  .faq-body {
    padding: 1.75rem 1.75rem 1.5rem;
  }
  .faq-heading {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }
</style>

<script>
  const sheetEl  = document.getElementById('faq-sheet');
  const backdrop = document.getElementById('faq-sheet-backdrop');
  const closeBtn = document.getElementById('faq-sheet-close-btn');

  const openFAQ = () => {
    sheetEl?.classList.add('is-open');
    backdrop?.classList.add('is-open');
    document.body.classList.add('overlay-active');
    closeBtn?.focus();
  };

  const closeFAQ = () => {
    sheetEl?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    document.body.classList.remove('overlay-active');

    // Collapse all open accordion items so it opens clean next time
    sheetEl?.querySelectorAll('.accordion-trigger.is-active').forEach((t) => {
      const trigger = t as HTMLButtonElement;
      trigger.classList.remove('is-active');
      trigger.setAttribute('aria-expanded', 'false');
      const content = trigger.nextElementSibling as HTMLElement;
      if (content) {
        content.style.maxHeight = '0px';
        content.classList.remove('is-open');
      }
    });
  };

  document.querySelectorAll('[data-open-faq]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); openFAQ(); })
  );

  closeBtn?.addEventListener('click', closeFAQ);
  backdrop?.addEventListener('click', closeFAQ);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sheetEl?.classList.contains('is-open')) closeFAQ();
  });
</script>

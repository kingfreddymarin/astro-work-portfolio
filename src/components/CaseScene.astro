---
import { projects } from '../data/portfolio.js';

// Each project can carry its own visual identity into the scene. Casa Blanca
// transitions into its real warm/editorial palette ("shore"); others fall back
// to the default dark studio theme until themed.
const themeFor = (index: string) => (index === '01' ? 'shore' : '');

// Serialize the data the scene needs; the overlay is populated by JS on open.
const sceneData = projects.map((p) => ({
  index: p.index,
  theme: themeFor(p.index),
  title: p.title,
  client: p.client ?? '',
  lead: p.description ?? '',
  status: p.url ? 'LIVE' : p.nda ? 'NDA' : 'ARCHIVE',
  sw: p.url ? '90 00' : p.nda ? '6F 00' : '90 00',
  nda: p.nda,
  metric: p.metric,
  story: p.story,
  tags: p.tags,
  url: p.url ?? null,
}));
---

<div class="scene" id="case-scene" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Project case study">
  <div class="scene-chrome">
    <button class="scene-close" type="button" data-scene-close>
      <span class="scene-close-x" aria-hidden="true">←</span>
      <span>BACK TO INDEX <i>[esc]</i></span>
    </button>
    <span class="scene-tag" data-field="status-chip"></span>
    <span class="scene-progress" aria-hidden="true"><i></i></span>
  </div>

  <div class="scene-scroll" data-scene-scroll>
    <!-- Parallax depth field (shared across acts) -->
    <div class="stage" aria-hidden="true">
      <div class="depth depth-stars" data-depth="0.14"></div>
      <div class="depth depth-glow" data-depth="0.07"></div>
      <div class="depth depth-grid" data-depth="0.5"></div>
      <div class="depth depth-bytes" data-depth="0.3" data-bytes></div>
    </div>

    <div class="acts">
      <!-- ACT 0 — title card -->
      <section class="act act-title">
        <div class="act-inner">
          <span class="line act-kicker"><b data-field="index"></b> · <span data-field="client"></span></span>
          <h1 class="line act-h1" data-field="title"></h1>
          <p class="line act-lead" data-field="lead"></p>
          <span class="line scroll-hint" aria-hidden="true">SCROLL TO DECODE<i></i></span>
        </div>
      </section>

      <!-- ACT 1 — the metric -->
      <section class="act act-metric">
        <div class="act-inner">
          <span class="line act-label">TRANSACTION RESULT //</span>
          <span class="line metric-value" data-field="metric-value"></span>
          <span class="line metric-label" data-field="metric-label"></span>
        </div>
      </section>

      <!-- ACT 2 — problem -->
      <section class="act act-beat" data-sw="6A 80">
        <div class="act-inner">
          <span class="line beat-head"><span class="beat-sw">6A 80</span><span class="beat-tag">PROBLEM</span></span>
          <p class="line beat-text" data-field="problem"></p>
        </div>
      </section>

      <!-- ACT 3 — approach -->
      <section class="act act-beat" data-sw="80 CA">
        <div class="act-inner">
          <span class="line beat-head"><span class="beat-sw">80 CA</span><span class="beat-tag">APPROACH</span></span>
          <p class="line beat-text" data-field="approach"></p>
        </div>
      </section>

      <!-- ACT 4 — outcome -->
      <section class="act act-beat act-outcome" data-sw="90 00">
        <div class="act-inner">
          <span class="line beat-head"><span class="beat-sw is-ok">90 00</span><span class="beat-tag">OUTCOME</span></span>
          <p class="line beat-text" data-field="outcome"></p>
        </div>
      </section>

      <!-- ACT 5 — stack + exit -->
      <section class="act act-stack">
        <div class="act-inner">
          <span class="line act-label">STACK //</span>
          <div class="line stack-tags" data-field="tags"></div>
          <div class="line stack-cta" data-field="cta"></div>
          <button class="line scene-restart" type="button" data-scene-close>CLOSE TRANSACTION ↩</button>
        </div>
      </section>
    </div>
  </div>

  <script type="application/json" id="case-scene-data" set:html={JSON.stringify(sceneData)} />
</div>

<style>
  /* ── Theme tokens (default = dark studio) ── */
  .scene {
    --s-bg:        #0E0F11;   /* washes in on open */
    --s-bg-open:   #050608;
    --s-ink:       #ECEEF0;
    --s-ink-soft:  #9BA1A8;
    --s-ink-faint: #5A6066;
    --s-accent:    #FFC24B;   /* primary highlight */
    --s-accent-2:  #FFC24B;   /* metric / secondary */
    --s-line:      rgba(236, 238, 240, 0.12);
    --s-star:      rgba(255, 255, 255, 0.7);
    --s-glow:
      radial-gradient(40vw 40vw at 75% 20%, rgba(255, 194, 75, 0.16), transparent 60%),
      radial-gradient(50vw 50vw at 15% 75%, rgba(80, 120, 255, 0.12), transparent 60%);
  }

  /* ── Casa Blanca "shore": its real warm editorial palette (OKLCH). The scene
        fully becomes Casa Blanca's world — cream paper, ink, forest, terra. ── */
  .scene[data-theme='shore'] {
    --s-bg-open:   oklch(96% 0.012 85);   /* cream */
    --s-ink:       oklch(20% 0.012 80);   /* ink */
    --s-ink-soft:  oklch(38% 0.018 80);
    --s-ink-faint: oklch(52% 0.02 80);
    --s-accent:    oklch(38% 0.05 145);   /* forest */
    --s-accent-2:  oklch(58% 0.11 50);    /* terra */
    --s-line:      oklch(20% 0.012 80 / 0.16);
    --s-star:      transparent;           /* no starfield on paper */
    /* layered horizon on cream: sun · terra core · sky band · ocean band */
    --s-glow:
      radial-gradient(36vw 36vw at 72% 14%, oklch(88% 0.06 80 / 0.85), transparent 60%),
      radial-gradient(24vw 24vw at 72% 14%, oklch(70% 0.13 55 / 0.45), transparent 58%),
      linear-gradient(180deg, transparent 42%, oklch(75% 0.06 230 / 0.30) 56%, transparent 66%),
      linear-gradient(180deg, transparent 64%, oklch(60% 0.08 220 / 0.32) 78%, transparent 92%);
  }

  .scene {
    position: fixed;
    inset: 0;
    z-index: 90000;
    background-color: var(--s-bg);
    color: var(--s-ink);
    opacity: 0;
    transform: scale(1.08);
    filter: blur(6px);
    transition:
      opacity 0.6s ease,
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.6s ease,
      background-color 0.9s ease,
      color 0.9s ease;
  }
  .scene[hidden] { display: none; }
  /* opening washes the index dark into the project's own palette */
  .scene.is-open { opacity: 1; transform: none; filter: none; background-color: var(--s-bg-open); }

  /* ── Chrome (fixed overlay UI) ── */
  .scene-chrome {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 5vw;
    pointer-events: none;
  }
  .scene-close,
  .scene-tag { pointer-events: auto; }
  .scene-close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    color: var(--s-ink-soft);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    cursor: pointer;
    transition: color 0.25s;
  }
  .scene-close i { color: var(--s-ink-faint); font-style: normal; }
  .scene-close:hover { color: var(--s-accent); }
  .scene-close-x { font-size: 1rem; transition: transform 0.3s; }
  .scene-close:hover .scene-close-x { transform: translateX(-4px); }
  .scene-tag {
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--s-ink-faint);
    border: 1px solid var(--s-line);
    border-radius: 2px;
    padding: 0.2rem 0.5rem;
  }
  .scene-progress {
    margin-left: auto;
    width: clamp(80px, 16vw, 200px);
    height: 1px;
    background: var(--s-line);
    position: relative;
  }
  .scene-progress i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: var(--s-accent-2);
    transition: width 0.1s linear;
  }

  /* ── Scroll container + perspective ── */
  .scene-scroll {
    position: absolute;
    inset: 0;
    overflow-x: hidden;
    overflow-y: auto;
    perspective: 1px;
    scroll-behavior: smooth;
  }

  /* ── Parallax depth field ── */
  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  /* generous vertical overscan so layers never slide out of frame while parallaxing */
  .depth { position: absolute; inset: -90% -10%; will-change: transform; transition: opacity 0.9s ease; }
  .depth-stars {
    background-image:
      radial-gradient(1px 1px at 20% 30%, var(--s-star), transparent),
      radial-gradient(1px 1px at 70% 60%, var(--s-star), transparent),
      radial-gradient(1.5px 1.5px at 40% 80%, var(--s-star), transparent),
      radial-gradient(1px 1px at 85% 20%, var(--s-star), transparent),
      radial-gradient(1px 1px at 10% 70%, var(--s-star), transparent),
      radial-gradient(1.5px 1.5px at 55% 15%, var(--s-star), transparent),
      radial-gradient(1px 1px at 90% 85%, var(--s-star), transparent),
      radial-gradient(1px 1px at 33% 50%, var(--s-star), transparent);
    background-size: 340px 340px;   /* tile → never runs out while parallaxing */
  }
  /* shore theme reads as warm dust, not a starfield */
  .scene[data-theme='shore'] .depth-stars { opacity: 0.5; }
  .depth-glow { background: var(--s-glow); }
  .depth-grid {
    background-image:
      linear-gradient(var(--s-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--s-line) 1px, transparent 1px);
    background-size: 72px 72px;
    opacity: 0.9;
    mask-image: radial-gradient(circle at 50% 40%, #000 45%, transparent 92%);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, #000 45%, transparent 92%);
  }
  .scene[data-theme='shore'] .depth-grid { opacity: 0.6; }
  .depth-bytes { font-family: 'Space Mono', monospace; }
  .byte {
    position: absolute;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--s-ink-faint);
    opacity: 0.65;
    white-space: nowrap;
    animation: byte-drift 14s ease-in-out infinite alternate;
  }
  .byte.is-tag { color: var(--s-accent-2); opacity: 0.9; font-size: 15px; }
  @keyframes byte-drift {
    from { transform: translateY(0); }
    to   { transform: translateY(-18px); }
  }

  /* ── Acts ── */
  .acts { position: relative; z-index: 1; }
  .act {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 6vw;
    text-align: center;
  }
  .act-title { min-height: 100vh; }
  .act-inner {
    max-width: 60rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    will-change: transform;
  }

  /* generic "dropped in your lap" reveal for each line */
  .line {
    opacity: 0;
    transform: translateY(70px) scale(0.96);
    filter: blur(8px);
    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.9s ease;
  }
  .act.in .line { opacity: 1; transform: none; filter: none; }
  .act.in .line:nth-child(2) { transition-delay: 0.1s; }
  .act.in .line:nth-child(3) { transition-delay: 0.22s; }
  .act.in .line:nth-child(4) { transition-delay: 0.34s; }

  .act-kicker {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--s-ink-faint);
  }
  .act-kicker b { color: var(--s-accent); font-weight: 400; }
  .act-h1 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .act-lead {
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: var(--s-ink-soft);
    max-width: 44ch;
  }
  .scroll-hint {
    margin-top: 2.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--s-ink-faint);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .scroll-hint i {
    width: 1px; height: 34px;
    background: linear-gradient(var(--s-accent), transparent);
    animation: hint-pulse 1.8s ease-in-out infinite;
  }
  @keyframes hint-pulse { 0%,100% { opacity: 0.3; transform: scaleY(0.6); } 50% { opacity: 1; transform: scaleY(1); } }

  .act-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.28em;
    color: var(--s-ink-faint);
  }
  .metric-value {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(5rem, 22vw, 18rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--s-accent-2);
    text-shadow: 0 0 60px color-mix(in oklch, var(--s-accent-2) 30%, transparent);
  }
  .metric-label {
    font-size: clamp(1rem, 2.2vw, 1.5rem);
    color: var(--s-ink-soft);
    max-width: 30ch;
  }

  .beat-head {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }
  .beat-sw {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--s-ink-faint);
    border: 1px solid var(--s-line);
    border-radius: 2px;
    padding: 0.15rem 0.45rem;
  }
  .beat-sw.is-ok {
    color: var(--s-accent);
    border-color: color-mix(in oklch, var(--s-accent) 45%, transparent);
    box-shadow: 0 0 12px color-mix(in oklch, var(--s-accent) 25%, transparent);
  }
  .beat-tag {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--s-ink-faint);
  }
  .beat-text {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 4.5vw, 3.6rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--s-ink);
    max-width: 22ch;
  }
  .act-outcome .beat-text { font-style: italic; }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    max-width: 42rem;
  }
  .stack-tags .tag {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--s-ink-soft);
    border: 1px solid var(--s-line);
    border-radius: 2px;
    padding: 0.3rem 0.6rem;
  }
  .stack-cta { margin-top: 1rem; }
  .stack-cta a {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--s-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--s-accent);
    padding-bottom: 0.25rem;
  }
  .stack-cta a:hover { color: var(--s-accent); }
  .stack-cta .nda {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--s-ink-faint);
  }
  .stack-cta .nda b { color: var(--s-ink-soft); font-weight: 400; border: 1px dashed var(--s-line); padding: 0.1rem 0.35rem; border-radius: 2px; }
  .scene-restart {
    margin-top: 2.5rem;
    background: none;
    border: 1px solid var(--s-line);
    border-radius: 2px;
    color: var(--s-ink-faint);
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    padding: 0.7rem 1.2rem;
    cursor: pointer;
    transition: color 0.25s, border-color 0.25s;
  }
  .scene-restart:hover { color: var(--s-accent); border-color: color-mix(in oklch, var(--s-accent) 40%, transparent); }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .scene { transition: opacity 0.2s ease; transform: none; filter: none; }
    .depth, .byte { animation: none; }
    .line { opacity: 1; transform: none; filter: none; transition: none; }
    .scroll-hint i { animation: none; }
    .scene-scroll { scroll-behavior: auto; }
  }

  @media (max-width: 768px) {
    .scene-chrome { padding: 1rem 5vw; gap: 0.75rem; }
    .scene-progress { width: 60px; }
    .act { padding: 6rem 7vw; }
    .beat-text { max-width: 16ch; }
  }
</style>

<script>
  const scene = document.getElementById('case-scene') as HTMLElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (scene) {
    const scroller = scene.querySelector<HTMLElement>('[data-scene-scroll]')!;
    const progress = scene.querySelector<HTMLElement>('.scene-progress i')!;
    const depths = Array.from(scene.querySelectorAll<HTMLElement>('.depth'));
    const acts = Array.from(scene.querySelectorAll<HTMLElement>('.act'));
    const fronts = Array.from(scene.querySelectorAll<HTMLElement>('.act-inner'));
    const bytesLayer = scene.querySelector<HTMLElement>('[data-bytes]')!;
    const data: any[] = JSON.parse(
      document.getElementById('case-scene-data')?.textContent || '[]'
    );

    const setText = (sel: string, val: string) => {
      const el = scene.querySelector<HTMLElement>(`[data-field="${sel}"]`);
      if (el) el.textContent = val;
    };

    function buildBytes(tags: string[]) {
      const hex = '0123456789ABCDEF';
      const rnd = (n: number) => Math.floor(Math.random() * n);
      const pair = () => hex[rnd(16)] + hex[rnd(16)];
      const items: string[] = [];
      for (let i = 0; i < 16; i++) items.push(`${pair()} ${pair()}`);
      tags.slice(0, 6).forEach((t) => items.push(t));
      bytesLayer.innerHTML = items
        .map((txt, i) => {
          const isTag = i >= 16;
          const top = rnd(92) + 2;
          const left = rnd(88) + 2;
          const delay = (Math.random() * 6).toFixed(2);
          const dur = (10 + Math.random() * 10).toFixed(2);
          return `<span class="byte${isTag ? ' is-tag' : ''}" style="top:${top}%;left:${left}%;animation-delay:${delay}s;animation-duration:${dur}s">${txt}</span>`;
        })
        .join('');
    }

    function populate(p: any) {
      setText('index', p.index);
      setText('client', p.client || p.status);
      setText('title', p.title);
      setText('lead', p.lead);
      setText('status-chip', `${p.sw} · ${p.status}`);
      setText('metric-value', p.metric?.value ?? '');
      setText('metric-label', p.metric?.label ?? '');
      setText('problem', p.story?.problem ?? '');
      setText('approach', p.story?.approach ?? '');
      setText('outcome', p.story?.outcome ?? '');

      const tagsEl = scene.querySelector<HTMLElement>('[data-field="tags"]');
      if (tagsEl) tagsEl.innerHTML = (p.tags || []).map((t: string) => `<span class="tag">${t}</span>`).join('');

      const ctaEl = scene.querySelector<HTMLElement>('[data-field="cta"]');
      if (ctaEl) {
        ctaEl.innerHTML = p.url
          ? `<a href="${p.url}" target="_blank" rel="noopener noreferrer">View project ↗</a>`
          : `<span class="nda"><b>6F 00</b> Confidential — references on request</span>`;
      }
      buildBytes(p.tags || []);
    }

    // ── Open / close ─────────────────────────────────────────
    let open = false;
    function openScene(index: string) {
      const p = data.find((d) => d.index === index);
      if (!p) return;
      scene.dataset.theme = p.theme || '';
      populate(p);
      acts.forEach((a) => a.classList.remove('in'));
      scene.hidden = false;
      scene.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      scroller.scrollTop = 0;
      // force reflow so the transition runs
      void scene.offsetWidth;
      requestAnimationFrame(() => {
        scene.classList.add('is-open');
        acts[0]?.classList.add('in');
      });
      open = true;
    }
    function closeScene() {
      if (!open) return;
      scene.classList.remove('is-open');
      document.body.style.overflow = '';
      open = false;
      const done = () => {
        scene.hidden = true;
        scene.setAttribute('aria-hidden', 'true');
        scene.removeEventListener('transitionend', done);
      };
      if (reduced) done();
      else scene.addEventListener('transitionend', done);
    }

    scene.querySelectorAll('[data-scene-close]').forEach((b) =>
      b.addEventListener('click', closeScene)
    );
    window.addEventListener('keydown', (e) => {
      if (open && e.key === 'Escape') closeScene();
    });
    window.addEventListener('case:open', (e: Event) => {
      const idx = (e as CustomEvent).detail.index;
      if (idx === '01') return; // Casa Blanca has its own bespoke commercial scene
      if (data.find((d) => d.index === idx)?.nda) return; // NDA projects use the archival confidential scene
      openScene(idx);
    });

    // ── Scroll-driven parallax + progress ────────────────────
    let ticking = false;
    function onScroll() {
      const s = scroller.scrollTop;
      const max = Math.max(1, scroller.scrollHeight - scroller.clientHeight);
      progress.style.width = `${Math.min(100, (s / max) * 100)}%`;
      if (!reduced) {
        // background planes drift at their own depth rate
        depths.forEach((d) => {
          const rate = parseFloat(d.dataset.depth || '0.1');
          d.style.transform = `translate3d(0, ${-s * rate}px, 0)`;
        });
        // foreground: each act's content glides past relative to its position,
        // so the words sit on a nearer plane than the grid behind them
        const mid = scroller.clientHeight / 2;
        fronts.forEach((f) => {
          const r = f.getBoundingClientRect();
          const offset = r.top + r.height / 2 - mid; // px from viewport center
          f.style.transform = `translate3d(0, ${offset * -0.12}px, 0)`;
        });
      }
      ticking = false;
    }
    scroller.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true }
    );

    // ── Reveal acts as they enter ────────────────────────────
    const io = new IntersectionObserver(
      (entries) => entries.forEach((en) => en.isIntersecting && en.target.classList.add('in')),
      { root: scroller, threshold: 0.35 }
    );
    acts.forEach((a) => io.observe(a));
  }
</script>

<div id="immersive-overlay" aria-label="3D Shooting Range" role="region">
  <canvas id="immersive-canvas"></canvas>

  <!-- Crosshair -->
  <div id="imm-crosshair">+</div>

  <!-- Ammo counter (bottom right) -->
  <div id="imm-ammo" class="imm-hud imm-hud--br">
    <div style="margin-bottom: 0.75rem;">
      <span id="imm-ammo-current">30</span>/<span id="imm-ammo-reserve">90</span>
    </div>
    <div id="imm-magazine" class="imm-magazine"></div>
  </div>

  <!-- Score & Accuracy (top right) -->
  <div id="imm-score" class="imm-hud imm-hud-score">
    <div id="imm-score-val">0</div>
    <div id="imm-accuracy">100%</div>
  </div>

  <!-- Status bar (reload, etc) -->
  <div id="imm-status" class="imm-hud imm-hud-status"></div>

  <!-- Click to play overlay -->
  <div id="imm-click-to-play" class="imm-overlay-screen" hidden>
    <div style="font-size: 32px; margin-bottom: 1rem;">⟳ CLICK TO PLAY</div>
    <div style="font-size: 12px; letter-spacing: 0.1em;">
      LMB · Shoot &nbsp;|&nbsp; R · Reload &nbsp;|&nbsp; P · Pause &nbsp;|&nbsp; WASD · Move
    </div>
  </div>

  <!-- Pause overlay -->
  <div id="imm-pause-overlay" class="imm-overlay-screen" hidden>
    <div style="font-size: 28px; margin-bottom: 2rem;">⏸ PAUSED</div>
    <div style="font-size: 12px; letter-spacing: 0.1em;">CLICK CANVAS TO RESUME</div>
  </div>

  <!-- HUD info panel (for hit info) -->
  <div id="imm-panel" class="imm-panel" aria-live="polite" hidden>
    <div id="imm-panel-content"></div>
  </div>
</div>

<script>
  import { initImmersive, destroyImmersive } from '../scripts/immersive';

  const overlay = document.getElementById('immersive-overlay')!;
  let isActive = false;

  function enter() {
    if (isActive) return;
    isActive = true;

    // Save scroll position
    const savedScroll = window.scrollY;
    sessionStorage.setItem('imm-scroll', String(savedScroll));

    // Disable Lenis
    const lenis = (window as any).__lenis;
    if (lenis) lenis.stop();

    // Activate overlay
    document.documentElement.setAttribute('data-mode', 'immersive');
    requestAnimationFrame(() => overlay.classList.add('active'));

    // Initialize 3D scene
    initImmersive();
  }

  function exit() {
    if (!isActive) return;
    isActive = false;

    // Fade out
    overlay.classList.remove('active');
    document.documentElement.removeAttribute('data-mode');

    // Cleanup 3D scene
    destroyImmersive();

    // Re-enable Lenis
    const lenis = (window as any).__lenis;
    if (lenis) {
      lenis.start();
      // Restore scroll position
      const saved = parseInt(sessionStorage.getItem('imm-scroll') ?? '0', 10);
      lenis.scrollTo(saved, { immediate: true });
    }
  }

  // Keyboard toggle
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key.toLowerCase() === 'i') {
      if (!isActive) enter();
      return;
    }
    if (e.key === 'Escape' && isActive) {
      exit();
    }
  });

  // Panel close button
  document.getElementById('imm-panel-close')?.addEventListener('click', () => {
    document.getElementById('imm-panel')!.hidden = true;
  });

  // Watch for programmatic attribute changes (button click)
  new MutationObserver(() => {
    const wantsImmersive = document.documentElement.getAttribute('data-mode') === 'immersive';
    if (wantsImmersive && !isActive) enter();
    if (!wantsImmersive && isActive) exit();
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-mode'],
  });

  // Theme change observer: rebuild scene if active
  new MutationObserver(() => {
    if (isActive) {
      destroyImmersive();
      initImmersive();
    }
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-style'],
  });
</script>

<style>
  #immersive-overlay {
    font-family: 'DM Mono', monospace;
  }

  #immersive-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

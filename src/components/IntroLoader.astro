<div id="intro" aria-hidden="true">
  <span id="intro-logo">FJM</span>
</div>

<style>
  #intro {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: all;
    transition: transform 0.72s cubic-bezier(0.76, 0, 0.24, 1);
  }
  #intro.out { transform: translateY(-100%); }

  #intro-logo {
    font-family: 'Cormorant Garant', serif;
    font-size: clamp(4rem, 15vw, 10rem);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.02em;
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.38s ease, transform 0.38s ease;
  }
  #intro-logo.in {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  const overlay = document.getElementById('intro');
  const logo    = document.getElementById('intro-logo') as HTMLElement | null;

  if (overlay && logo) {
    document.body.style.overflow = 'hidden';

    const C = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$!?&';
    function scramble(el: HTMLElement, duration = 480) {
      const orig = el.textContent ?? '';
      const t0   = performance.now();
      (function tick(now: number) {
        const p = Math.min((now - t0) / duration, 1);
        el.textContent = orig.split('').map((ch, i) =>
          i / orig.length < p ? ch : C[Math.floor(Math.random() * C.length)]
        ).join('');
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = orig;
      })(performance.now());
    }

    setTimeout(() => logo.classList.add('in'), 80);
    setTimeout(() => scramble(logo),             140);
    setTimeout(() => overlay.classList.add('out'), 820);
    setTimeout(() => {
      document.body.style.overflow = '';
      overlay.remove();
    }, 1540);
  }
</script>

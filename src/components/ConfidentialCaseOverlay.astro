    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-overlay,
    :global(.cc-hero-inner),
    :global(.cc-paper-head),
    :global(.cc-abstract),
    :global(.cc-section),
    :global(.cc-figure),
    :global(.cc-notes) {
      transition: none;
      transform: none;
      filter: none;
    }

    .cc-backdrop { animation: none; }

    :global([data-cc-reveal]) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const ccOverlay = document.getElementById('confidential-case-overlay') as HTMLElement | null;

  if (ccOverlay) {
    const scroller = ccOverlay.querySelector<HTMLElement>('[data-cc-scroll]')!;
    const backdrop = ccOverlay.querySelector<HTMLElement>('[data-cc-backdrop]');
    const progress = ccOverlay.querySelector<HTMLElement>('.cc-progress i')!;
    const status = ccOverlay.querySelector<HTMLElement>('[data-cc-status]')!;
    const articles = Array.from(ccOverlay.querySelectorAll<HTMLElement>('[data-case-article]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeArticle: HTMLElement | null = null;
    let open = false;

    function revealVisible(article: HTMLElement) {
      const revealItems = Array.from(article.querySelectorAll<HTMLElement>('[data-cc-reveal]'));
      if (reduced) {
        revealItems.forEach((el) => el.classList.add('cc-revealed'));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('cc-revealed');
          io.unobserve(entry.target);
        }),
        { root: scroller, threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
      );

      revealItems.forEach((el) => io.observe(el));
      requestAnimationFrame(() => revealItems.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < scroller.clientHeight * 0.92 && r.bottom > 0) el.classList.add('cc-revealed');
      }));
    }

    function showArticle(article: HTMLElement) {
      articles.forEach((candidate) => {
        const isActive = candidate === article;
        candidate.classList.toggle('is-active', isActive);
        candidate.setAttribute('aria-hidden', String(!isActive));
        candidate.querySelectorAll('[data-cc-reveal]').forEach((el) => el.classList.remove('cc-revealed'));
      });
      activeArticle = article;
      status.textContent = `${article.dataset.index || ''} / 6F 00 / NDA`;
      revealVisible(article);
    }

    function openCase(index: string) {
      const article = articles.find((candidate) => candidate.dataset.index === index);
      if (!article) return;

      showArticle(article);
      ccOverlay.hidden = false;
      ccOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      scroller.scrollTop = 0;
      progress.style.width = '0%';

      void ccOverlay.offsetWidth;
      requestAnimationFrame(() => ccOverlay.classList.add('is-open'));
      open = true;
    }

    function closeCase() {
      if (!open) return;
      ccOverlay.classList.remove('is-open');
      document.body.style.overflow = '';
      open = false;

      const done = () => {
        ccOverlay.hidden = true;
        ccOverlay.setAttribute('aria-hidden', 'true');
        activeArticle?.classList.remove('is-active');
        activeArticle?.setAttribute('aria-hidden', 'true');
        activeArticle = null;
        ccOverlay.removeEventListener('transitionend', done);
      };

      if (reduced) done();
      else ccOverlay.addEventListener('transitionend', done);
    }

    ccOverlay.querySelectorAll('[data-cc-close]').forEach((button) => {
      button.addEventListener('click', closeCase);
    });

    window.addEventListener('keydown', (event) => {
      if (open && event.key === 'Escape') closeCase();
    });

    window.addEventListener('case:open', (event: Event) => {
      const index = (event as CustomEvent).detail?.index;
      if (index) openCase(index);
    });

    let ticking = false;
    scroller.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const top = scroller.scrollTop;
        const max = Math.max(1, scroller.scrollHeight - scroller.clientHeight);
        progress.style.width = `${Math.min(100, (top / max) * 100)}%`;
        if (backdrop && !reduced) backdrop.style.transform = `translate3d(0, ${top * 0.04}px, 0)`;
        ticking = false;
      });
    }, { passive: true });
  }
</script>

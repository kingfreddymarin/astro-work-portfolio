    :global(.cc-paper) {
      width: min(100% - 18px, 720px);
      padding: 28px 20px 34px;
    }

    :global(.cc-columns),
    :global(.cc-notes ol) {
      column-count: 1;
      column-rule: 0;
    }

    :global(.cc-process-shell),
    :global(.cc-outcomes) {

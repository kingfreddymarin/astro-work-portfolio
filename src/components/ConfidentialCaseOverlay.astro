---
import { projects } from '../data/portfolio.js';
import ConfidentialCaseStudy from './ConfidentialCaseStudy.astro';

const confidentialProjects = projects.filter((project) => project.nda);
---

<div class="cc-overlay" id="confidential-case-overlay" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Confidential project case study">
  <div class="cc-backdrop" data-cc-backdrop aria-hidden="true"></div>
  <div class="cc-grid" aria-hidden="true"></div>
  <div class="cc-vignette" aria-hidden="true"></div>

  <div class="cc-chrome">
    <button class="cc-close" type="button" data-cc-close>
      <span aria-hidden="true">&larr;</span>
      <span>BACK TO INDEX <i>[esc]</i></span>
    </button>
    <span class="cc-status" data-cc-status>6F 00 / NDA</span>
    <span class="cc-progress" aria-hidden="true"><i></i></span>
  </div>

  <div class="cc-scroll" data-cc-scroll>
    {confidentialProjects.map((project) => <ConfidentialCaseStudy project={project} />)}
  </div>
</div>

<style>
  .cc-overlay {
    --cc-ink: var(--ink);
    --cc-soft: var(--ink-2);
    --cc-faint: var(--ink-3);
    --cc-paper: var(--surface);
    --cc-paper-edge: var(--border-2);
    --cc-bg: var(--bg);
    --cc-line: var(--border);
    --cc-accent: var(--accent);
    --cc-trace: var(--trace);
    --cc-danger: var(--live);

    position: fixed;
    inset: 0;
    z-index: 93000;
    min-height: 100vh;
    background: var(--cc-bg);
    color: var(--cc-ink);
    font-family: 'DM Sans', 'Hanken Grotesk', sans-serif;
    opacity: 0;
    transform: scale(1.04);
    filter: blur(6px);
    transition: opacity 0.55s ease, transform 0.75s cubic-bezier(0.22, 1, 0.36, 1), filter 0.55s ease;
  }

  .cc-overlay[hidden] { display: none; }
  .cc-overlay.is-open {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .cc-backdrop,
  .cc-grid,
  .cc-vignette {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .cc-backdrop {
    inset: -8% -4%;
    background:
      radial-gradient(80% 60% at 78% 16%, color-mix(in oklch, var(--cc-accent) 12%, transparent), transparent 58%),
      radial-gradient(70% 70% at 14% 80%, color-mix(in oklch, var(--cc-trace) 8%, transparent), transparent 62%),
      linear-gradient(180deg, var(--cc-bg) 0%, #08090b 100%);
    animation: cc-drift 32s ease-in-out infinite;
    will-change: transform;
  }

  .cc-grid {
    opacity: 0.9;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 55px, var(--cc-line) 55px 56px),
      repeating-linear-gradient(90deg, transparent 0 55px, var(--cc-line) 55px 56px),
      radial-gradient(circle at 50% 38%, color-mix(in oklch, var(--cc-accent) 4%, transparent), transparent 62%);
    mask-image: radial-gradient(130% 90% at 50% 40%, #000 30%, transparent 92%);
    -webkit-mask-image: radial-gradient(130% 90% at 50% 40%, #000 30%, transparent 92%);
  }

  .cc-vignette {
    box-shadow: inset 0 0 220px 72px rgba(0, 0, 0, 0.76);
  }

  @keyframes cc-drift {
    0% { transform: translate3d(0, 0, 0) scale(1.04); }
    50% { transform: translate3d(-1.2%, -1.4%, 0) scale(1.08); }
    100% { transform: translate3d(0, 0, 0) scale(1.04); }
  }

  .cc-chrome {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem var(--edge-pad);
    pointer-events: none;
  }

  .cc-close,
  .cc-status {
    pointer-events: auto;
  }

  .cc-close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: 0;
    color: var(--cc-soft);
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    cursor: pointer;
    transition: color 0.25s;
  }

  .cc-close i {
    color: var(--cc-faint);
    font-style: normal;
  }

  .cc-close:hover { color: var(--cc-accent); }

  .cc-status {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--cc-faint);
    border: 1px solid var(--cc-line);
    border-radius: 2px;
    padding: 0.2rem 0.5rem;
  }

  .cc-progress {
    margin-left: auto;
    width: clamp(80px, 16vw, 200px);
    height: 1px;
    background: var(--cc-line);
    position: relative;
  }

  .cc-progress i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: var(--cc-accent);
  }

  .cc-scroll {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow-x: hidden;
    overflow-y: auto;
    scroll-behavior: smooth;
  }

  :global(.cc-article) {
    display: none;
    min-height: 100vh;
  }

  :global(.cc-article.is-active) {
    display: block;
  }

  :global(.cc-hero) {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 24px;
    color: var(--cc-ink);
    pointer-events: none;
  }

  :global(.cc-hero-inner) {
    max-width: 58rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 1.2s cubic-bezier(0.2, 0.7, 0.2, 1), transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.cc-revealed) {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  :global(.cc-kicker) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--cc-accent);
    margin-bottom: 26px;
  }

  :global(.cc-hero h1) {
    font-family: "Cormorant Garamond", Fraunces, Georgia, serif;
    font-weight: 300;
    font-size: clamp(40px, 7vw, 86px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 13ch;
    text-wrap: balance;
    margin: 0 auto;
  }

  :global(.cc-hero p) {
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.45;
    color: var(--cc-soft);
    max-width: 50ch;
    margin: 24px auto 0;
    text-wrap: pretty;
  }

  :global(.cc-hero-meta) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--cc-faint);
    text-transform: uppercase;
    margin-top: 26px;
  }

  :global(.cc-paper) {
    position: relative;
    z-index: 3;
    width: min(1120px, calc(100% - 32px));
    margin: 92vh auto 0;
    padding: clamp(28px, 5vw, 76px);
    background:
      linear-gradient(90deg, color-mix(in oklch, var(--cc-accent) 4%, transparent) 0 1px, transparent 1px 100%),
      var(--cc-paper);
    background-size: 28px 28px;
    border: 1px solid var(--cc-paper-edge);
    box-shadow: 0 34px 110px rgba(0, 0, 0, 0.54);
  }

  :global(.cc-paper-head) {
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1.1s cubic-bezier(0.2, 0.7, 0.2, 1), transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.cc-paper-label) {
    display: flex;
    justify-content: center;
    gap: 10px;
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cc-accent);
    margin-bottom: 20px;
  }

  :global(.cc-paper-label span:nth-child(2)) { color: var(--cc-paper-edge); }
  :global(.cc-paper-label span:nth-child(3)) { color: var(--cc-soft); }

  :global(.cc-paper-head h2) {
    font-family: 'Cormorant Garamond', 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: clamp(30px, 4.4vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    max-width: 18ch;
    margin: 0 auto;
    text-wrap: balance;
  }

  :global(.cc-paper-head p) {
    font-weight: 300;
    font-size: clamp(16px, 1.8vw, 19px);
    color: var(--cc-soft);
    margin: 14px auto 0;
    max-width: 58ch;
    line-height: 1.5;
    text-wrap: pretty;
  }

  :global(.cc-byline) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--cc-soft);
    margin-top: 22px;
  }

  :global(.cc-byline sup) { color: var(--cc-accent); }

  :global(.cc-rule) {
    height: 3px;
    border-top: 1px solid var(--cc-paper-edge);
    border-bottom: 1px solid var(--cc-paper-edge);
    margin: 34px 0;
  }

  :global(.cc-soft-rule) {
    height: 1px;
    background: var(--cc-paper-edge);
    margin: 0 0 48px;
  }

  :global(.cc-abstract),
  :global(.cc-section),
  :global(.cc-figure),
  :global(.cc-notes) {
    opacity: 100;
    transform: translateY(30px);
    transition: opacity 1.1s cubic-bezier(0.2, 0.7, 0.2, 1), transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(.cc-abstract) {
    padding: 0 clamp(0px, 4vw, 52px);
    margin-bottom: 30px;
  }

  :global(.cc-abstract p:first-child) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--cc-soft);
    text-align: justify;
    hyphens: auto;
    text-wrap: pretty;
  }

  :global(.cc-abstract p:first-child span) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cc-accent);
    padding-right: 8px;
  }

  :global(.cc-keywords) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--cc-soft);
    margin-top: 16px;
  }

  :global(.cc-keywords strong) {
    color: var(--cc-ink);
    font-weight: 400;
  }

  :global(.cc-section) {
    margin-bottom: 88px;
  }

  :global(.cc-prose) {
    font-size: 14.5px;
    line-height: 1.72;
    color: var(--cc-soft);
    text-align: justify;
    hyphens: auto;
    margin-bottom: 22px;
  }

  :global(.cc-questions) {
    display: grid;
    gap: 12px;
  }

  :global(.cc-questions div) {
    border: 1px solid var(--cc-paper-edge);
    background: var(--surface-2);
    padding: 14px 16px;
  }

  :global(.cc-questions span) {
    display: block;
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cc-accent);
    margin-bottom: 6px;
  }

  :global(.cc-questions p) {
    font-size: 14.5px;
    line-height: 1.58;
    color: var(--cc-soft);
  }

  :global(.cc-section-head) {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 20px;
  }

  :global(.cc-section-head span) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 13px;
    color: var(--cc-accent);
  }

  :global(.cc-section-head h3) {
    font-weight: 600;
    font-size: clamp(19px, 2.2vw, 23px);
    letter-spacing: 0.005em;
  }

  :global(.cc-columns) {
    column-count: 2;
    column-gap: 46px;
    column-rule: 1px solid var(--cc-paper-edge);
    font-size: 14.5px;
    line-height: 1.72;
    color: var(--cc-soft);
  }

  :global(.cc-columns p) {
    text-align: justify;
    hyphens: auto;
    margin-bottom: 14px;
  }

  :global(.cc-dropcap) {
    float: left;
    font-weight: 600;
    font-size: 52px;
    line-height: 0.74;
    padding: 6px 9px 0 0;
    color: var(--cc-accent);
  }

  :global(.cc-process-shell),
  :global(.cc-outcomes) {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: start;
  }

  :global(.cc-process-copy) {
    flex: 1 1 36rem;
    min-width: 0;
  }

  :global(.cc-severity-figure) {
    flex: 1 1 18rem;
    min-width: 0;
    margin: 0;
  }

  :global(.cc-outcomes) {
    margin-bottom: 30px;
  }

  :global(.cc-outcomes > figure) {
    flex: 1 1 24rem;
    min-width: 0;
  }

  :global(.cc-outcomes > div) {
    flex: 1 1 26rem;
    min-width: 0;
    max-width: 433.203125px;
  }

  :global(.cc-process-copy) {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(.cc-process-copy > p),
  :global(.cc-outcomes > div > p) {
    font-size: 14.5px;
    line-height: 1.72;
    color: var(--cc-soft);
    text-align: justify;
    hyphens: auto;
  }

  :global(.cc-step) {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    border-top: 1px solid var(--cc-paper-edge);
    padding-top: 16px;
  }

  :global(.cc-step div) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cc-accent);
  }

  :global(.cc-step p) {
    font-size: 14px;
    line-height: 1.66;
    color: var(--cc-soft);
    text-align: justify;
    hyphens: auto;
  }

  :global(.cc-figure) {
    margin: 0;
  }

  :global(.cc-figure-tall) {
    position: sticky;
    top: 80px;
  }

  :global(.cc-figure-wide) {
    margin: 0 0 80px;
    width: 100%;
  }

  :global(.cc-figure-detail) {
    margin: 0 0 96px;
    width: 100%;
  }

  :global(.cc-figure-art) {
    width: 100%;
    border-radius: 2px;
    background-color: var(--surface-2);
    background-image:
      repeating-linear-gradient(45deg, color-mix(in oklch, var(--cc-accent) 8%, transparent) 0 12px, transparent 12px 24px),
      linear-gradient(180deg, color-mix(in oklch, var(--cc-trace) 4%, transparent), transparent);
    border: 1px solid var(--cc-paper-edge);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  :global(.cc-figure-tall .cc-figure-art) { aspect-ratio: 3 / 4; }
  :global(.cc-figure-wide .cc-figure-art) { aspect-ratio: 16 / 9; }
  :global(.cc-outcomes .cc-figure-art) { aspect-ratio: 4 / 3; }
  :global(.cc-figure-detail .cc-figure-art) { aspect-ratio: 21 / 9; }

  :global(.cc-method-art) {
    flex-direction: column;
    gap: 18px;
  }

  :global(.cc-method-art span),
  :global(.cc-system-art span),
  :global(.cc-detail-art span) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cc-soft);
    border: 1px solid var(--cc-line);
    background: var(--surface);
    padding: 0.32rem 0.55rem;
  }

  :global(.cc-system-art) {
    align-content: center;
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 32px;
  }

  :global(.cc-result-art span) {
    font-size: clamp(52px, 12vw, 120px);
    line-height: 0.9;
    color: var(--cc-accent);
  }

  :global(.cc-detail-art span) {
    max-width: 80%;
    text-align: center;
  }

  :global(.cc-figure figcaption) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--cc-soft);
    margin-top: 12px;
    line-height: 1.6;
  }

  :global(.cc-figure figcaption b) {
    color: var(--cc-accent);
    font-weight: 400;
  }

  :global(.cc-severity-chart) {
    border: 1px solid var(--cc-paper-edge);
    border-radius: 2px;
    overflow: hidden;
  }

  :global(.cc-severity-row) {
    display: grid;
    grid-template-columns: 100px 1fr 48px;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--cc-paper-edge);
  }

  :global(.cc-severity-row:last-child) {
    border-bottom: 0;
  }

  :global(.cc-severity-row.is-critical) { background: color-mix(in oklch, var(--cc-danger) 7%, transparent); }
  :global(.cc-severity-row.is-high) { background: color-mix(in oklch, var(--cc-accent) 6%, transparent); }
  :global(.cc-severity-row.is-medium) { background: color-mix(in oklch, var(--cc-accent) 4%, transparent); }
  :global(.cc-severity-row.is-good) { background: color-mix(in oklch, var(--cc-trace) 5%, transparent); }

  :global(.cc-sev-tag),
  :global(.cc-ft-sev) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    border-radius: 2px;
    white-space: nowrap;
  }

  :global(.cc-sev-tag) {
    display: block;
    padding: 4px 8px;
    text-align: center;
  }

  :global(.cc-ft-sev) {
    display: inline-block;
    padding: 3px 7px;
  }

  :global(.cc-sev-tag.is-critical),
  :global(.cc-ft-sev.is-critical),
  :global(.cc-sev-bar.is-critical) { background: var(--cc-danger); }
  :global(.cc-sev-tag.is-high),
  :global(.cc-ft-sev.is-high),
  :global(.cc-sev-bar.is-high) { background: var(--cc-accent); color: var(--cc-bg); }
  :global(.cc-sev-tag.is-medium),
  :global(.cc-ft-sev.is-medium),
  :global(.cc-sev-bar.is-medium) { background: color-mix(in oklch, var(--cc-accent) 68%, var(--cc-soft)); color: var(--cc-bg); }
  :global(.cc-sev-tag.is-low),
  :global(.cc-ft-sev.is-low),
  :global(.cc-sev-bar.is-low) { background: var(--cc-faint); }
  :global(.cc-sev-tag.is-good),
  :global(.cc-ft-sev.is-good),
  :global(.cc-sev-bar.is-good) { background: var(--cc-trace); color: var(--cc-bg); }

  :global(.cc-sev-bar-wrap) {
    height: 8px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--cc-paper-edge);
  }

  :global(.cc-sev-bar) {
    height: 100%;
    border-radius: 2px;
  }

  :global(.cc-sev-count) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--cc-ink);
    text-align: right;
  }

  :global(.cc-findings-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  :global(.cc-findings-table th) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cc-soft);
    text-align: left;
    padding: 8px 12px;
    border-bottom: 2px solid var(--cc-ink);
  }

  :global(.cc-findings-table td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--cc-paper-edge);
    vertical-align: top;
    line-height: 1.55;
    color: var(--cc-soft);
  }

  :global(.cc-findings-table td:last-child) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 10.5px;
    color: var(--cc-soft);
  }

  :global(.cc-findings-table tr:last-child td) {
    border-bottom: 0;
  }

  :global(.cc-good-list) {
    display: flex;
    flex-direction: column;
  }

  :global(.cc-good-item) {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--cc-paper-edge);
  }

  :global(.cc-good-item:last-child) {
    border-bottom: 0;
  }

  :global(.cc-good-item > span) {
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 11px;
    color: var(--cc-trace);
    padding-top: 1px;
  }

  :global(.cc-good-item div) {
    font-size: 13.5px;
    line-height: 1.58;
    color: var(--cc-soft);
  }

  :global(.cc-good-item strong) {
    display: block;
    font-family: 'DM Mono', 'Space Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cc-soft);
    margin-bottom: 3px;
    font-weight: 400;
  }

  :global(.cc-metrics) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
    gap: 1px;
    background: var(--cc-paper-edge);
    border: 1px solid var(--cc-paper-edge);
    margin-top: 22px;
  }

  :global(.cc-metrics div) {
    background: var(--cc-paper);
    padding: 18px 16px;
  }

  :global(.cc-metrics strong) {
    display: block;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--cc-accent);
  }

  :global(.cc-metrics span) {
    display: block;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--cc-soft);
    margin-top: 8px;
  }

  :global(.cc-scale-grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

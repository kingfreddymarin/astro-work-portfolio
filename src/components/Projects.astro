---
import { projects } from '../data/portfolio.js';

const marqueeFor = (title: string, tags: string[]) =>
  [title, ...tags].join('  ✦  ') + '  ✦  ';

type Project = (typeof projects)[number];
const statusOf = (p: Project) => (p.url ? 'LIVE' : p.nda ? 'CLASSIFIED' : 'ARCHIVE');
---

<section id="projects">
  <div class="work-inner">
    <div class="section-header reveal">
      <span class="section-number">03</span>
      <h2 class="section-title">Selected work</h2>
      <span class="work-telemetry" aria-hidden="true">
        <span id="work-tele-text">INDEX // {String(projects.length).padStart(2, '0')} ENTRIES</span><span class="work-caret"></span>
      </span>
    </div>

    <ul class="work-index">
      {projects.map((p, i) => {
        const { index, title, description, tags, url } = p;
        const status = statusOf(p);
        return (
          <li
            class="work-row reveal"
            style={`transition-delay: ${i * 70}ms`}
            data-title={title}
            data-index={index}
            data-status={status}
            data-stack={String(tags.length).padStart(2, '0')}
          >
            <button
              class="work-head"
              aria-expanded="false"
              aria-controls={`work-panel-${index}`}
            >
              <span class="work-no">{index}</span>
              <span class="work-title" data-text={title}>{title}</span>
              <span class="work-meta">
                <span class={`work-status is-${status.toLowerCase()}`}>
                  <span class="ws-dot"></span>
                  <span class="ws-label">{status}</span>
                </span>
                <span class="work-toggle" aria-hidden="true">
                  <span class="work-toggle-h"></span>
                  <span class="work-toggle-v"></span>
                </span>
              </span>
            </button>

            <div class="work-panel" id={`work-panel-${index}`}>
              <div class="work-panel-clip">
                <div class="work-banner" aria-hidden="true">
                  <span class="work-banner-track">
                    {[0, 1, 2, 3].map(() => (
                      <span class="work-banner-chunk">{marqueeFor(title, tags)}</span>
                    ))}
                  </span>
                </div>
                <div class="work-panel-inner">
                  <div class="work-brief">
                    <span class="work-label">BRIEF //</span>
                    <p class="work-desc">{description}</p>
                  </div>
                  <div class="work-aside">
                    <span class="work-label">STACK [{String(tags.length).padStart(2, '0')}] //</span>
                    <div class="work-tags">
                      {tags.map(tag => <span class="tag">{tag}</span>)}
                    </div>
                    {url && (
                      <a href={url} class="work-link" target="_blank" rel="noopener noreferrer">
                        Access project <span class="work-link-arrow">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  #projects {
    padding: 6rem 5vw 5rem;
    background-image:
      linear-gradient(rgba(240, 239, 233, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 239, 233, 0.028) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  /* ── Telemetry readout ── */
  .work-telemetry {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    max-width: min(64ch, 40vw);
  }
  .work-caret {
    width: 6px;
    height: 11px;
    background: var(--accent);
    flex-shrink: 0;
    animation: work-caret-blink 1.1s step-end infinite;
  }
  @keyframes work-caret-blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  /* ── Index list + corner brackets ── */
  .work-index {
    list-style: none;
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  .work-index::before,
  .work-index::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }
  .work-index::before {
    top: -1px;
    left: 0;
    border-top: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
  }
  .work-index::after {
    bottom: -1px;
    right: 0;
    border-bottom: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
  }

  .work-row {
    border-top: 1px solid var(--border);
  }

  /* ── Row head ── */
  .work-head {
    position: relative;
    overflow: hidden;
    width: 100%;
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.6rem 0.25rem;
    background: none;
    border: none;
    color: inherit;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }

  .work-no {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    transition: color 0.3s;
  }
  .work-no::before { content: '['; color: var(--ink-3); }
  .work-no::after  { content: ']'; color: var(--ink-3); }

  .work-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 4.2vw, 3.4rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    align-self: center;
  }

  /* ── Status readout ── */
  .work-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }
  .ws-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink-3);
    flex-shrink: 0;
  }
  .work-status.is-live { color: var(--accent); }
  .work-status.is-live .ws-dot {
    background: var(--accent);
    box-shadow: 0 0 8px rgba(255, 194, 75, 0.7);
    animation: work-status-pulse 1.8s ease-in-out infinite;
  }
  .work-status.is-classified .ws-dot {
    background: transparent;
    border: 1px solid var(--ink-3);
  }
  @keyframes work-status-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  /* plus → minus toggle */
  .work-toggle {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .work-toggle-h,
  .work-toggle-v {
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--ink-2);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s;
  }
  .work-toggle-h { width: 14px; height: 1.5px; }
  .work-toggle-v { width: 1.5px; height: 14px; }
  .work-row.open .work-toggle-v { transform: rotate(90deg) scaleY(0); }
  .work-row.open .work-toggle-h { background: var(--accent); }

  /* ── Hover: title shift ── */
  @media (hover: hover) {
    .work-head:hover .work-title {
      transform: translateX(1.25rem);
    }
    .work-head:hover .work-no { color: var(--accent); }
  }
  .work-row.open .work-title { color: var(--accent); }
  .work-row.open .work-no { color: var(--accent); }

  /* ── Tech banner (inside the opened dossier) ── */
  .work-banner {
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--accent);
    /* collapsed until the row opens */
    height: 0;
    opacity: 0;
    transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
  }
  .work-row.open .work-banner {
    height: 2.6em;
    opacity: 1;
  }

  .work-banner-track {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
    animation: work-banner-scroll 26s linear infinite;
  }
  .work-banner-chunk {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(1.1rem, 2.4vw, 1.7rem);
    line-height: 2.6em;
    color: var(--bg);
    padding-right: 0.5em;
  }

  @keyframes work-banner-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Expanding panel ── */
  .work-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-row.open .work-panel {
    grid-template-rows: 1fr;
  }
  .work-panel-clip {
    overflow: hidden;
    min-height: 0;
  }

  .work-panel-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding: 0.75rem 1.25rem 2.25rem 4.5rem;
  }
  /* corner ticks framing the open dossier */
  .work-panel-inner::before,
  .work-panel-inner::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    opacity: 0.65;
  }
  .work-panel-inner::before {
    top: 0;
    left: 3.25rem;
    border-top: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
  }
  .work-panel-inner::after {
    bottom: 1.25rem;
    right: 0;
    border-bottom: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
  }

  .work-label {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }

  .work-desc {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.8;
    max-width: 58ch;
  }

  .work-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }
  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .work-link {
    margin-top: 1.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2rem;
    transition: color 0.2s;
  }
  .work-link:hover { color: var(--accent); }
  .work-link-arrow { color: var(--accent); }

  /* stagger panel children on open */
  .work-brief,
  .work-aside {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .work-row.open .work-brief {
    opacity: 1;
    transform: none;
    transition-delay: 0.18s;
  }
  .work-row.open .work-aside {
    opacity: 1;
    transform: none;
    transition-delay: 0.28s;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .work-banner-track { animation: none; }
    .work-caret { animation: none; }
    .work-status.is-live .ws-dot { animation: none; }
    .work-banner,
    .work-panel,
    .work-title,
    .work-brief,
    .work-aside { transition: none; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #projects { padding: 4rem 5vw 3rem; background-size: 40px 40px; }
    .work-telemetry { display: none; }
    .work-head {
      grid-template-columns: 2.5rem 1fr auto;
      gap: 0.85rem;
      padding: 1.25rem 0;
    }
    .work-title { font-size: clamp(1.35rem, 6.5vw, 1.7rem); }
    .work-meta { gap: 0.75rem; }
    .ws-label { display: none; }
    .work-panel-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0.5rem 0 1.75rem 2.5rem;
    }
    .work-panel-inner::before { left: 1.5rem; }
  }
</style>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.work-row'));
  const teleText = document.getElementById('work-tele-text');
  const teleDefault = teleText?.textContent ?? '';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Text decode scramble ── */
  const GLYPHS = 'ABCDEFGHKMNPRSTUVWXYZ0123456789#/<>*';
  const scrambling = new WeakSet<HTMLElement>();

  function scramble(el: HTMLElement, duration = 700) {
    const target = el.dataset.text ?? el.textContent ?? '';
    if (reducedMotion || scrambling.has(el)) return;
    scrambling.add(el);
    const start = performance.now();

    function frame(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const settled = Math.floor(t * target.length);
      let out = target.slice(0, settled);
      for (let i = settled; i < target.length; i++) {
        const ch = target[i];
        out += ch === ' ' ? ' ' : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      }
      el.textContent = out;
      if (t < 1) requestAnimationFrame(frame);
      else {
        el.textContent = target;
        scrambling.delete(el);
      }
    }
    requestAnimationFrame(frame);
  }

  /* ── Telemetry readout ── */
  function readout(row: HTMLElement) {
    if (!teleText) return;
    const { index, title, stack, status } = row.dataset;
    teleText.textContent = `${index} // ${title?.toUpperCase()} // STACK[${stack}] // ${status}`;
  }
  function readoutReset() {
    if (teleText) teleText.textContent = teleDefault;
  }

  /* ── Accordion ── */
  function setOpen(row: HTMLElement, open: boolean) {
    row.classList.toggle('open', open);
    row.querySelector('.work-head')?.setAttribute('aria-expanded', String(open));
  }

  rows.forEach((row) => {
    const head = row.querySelector<HTMLButtonElement>('.work-head');
    const title = row.querySelector<HTMLElement>('.work-title');

    head?.addEventListener('click', () => {
      const wasOpen = row.classList.contains('open');
      rows.forEach((r) => setOpen(r, false));
      if (!wasOpen) {
        setOpen(row, true);
        if (title) scramble(title, 600);
      }
      readout(row);
    });

    head?.addEventListener('mouseenter', () => {
      readout(row);
    });
  });

  document.querySelector('.work-index')?.addEventListener('mouseleave', readoutReset);

  /* ── Number shortcut: on the Work view, type a 2-digit index (01–99) to open ── */
  function openByIndex(idx: string) {
    const row = rows.find((r) => r.dataset.index === idx);
    if (!row) return;
    if (!row.classList.contains('open')) {
      rows.forEach((r) => setOpen(r, false));
      setOpen(row, true);
      const title = row.querySelector<HTMLElement>('.work-title');
      if (title) scramble(title, 600);
      readout(row);
    }
    row.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
  }

  let digitBuf = '';
  let digitTimer = 0;
  window.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (document.querySelector('.view.is-active')?.getAttribute('data-view') !== 'work') return;
    if (document.body.classList.contains('menu-open')) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA'
      || t.tagName === 'SELECT' || t.isContentEditable)) return;
    if (!/^[0-9]$/.test(e.key)) return;

    e.preventDefault();
    clearTimeout(digitTimer);
    digitBuf += e.key;
    if (digitBuf.length === 2) {
      openByIndex(digitBuf);
      digitBuf = '';
    } else {
      // wait for the second digit; reset if it doesn't arrive
      digitTimer = window.setTimeout(() => { digitBuf = ''; }, 1000);
    }
  });

  /* ── Decode titles on first reveal, then open the first entry ── */
  const decoded = new WeakSet<HTMLElement>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const row = entry.target as HTMLElement;
        if (decoded.has(row)) return;
        decoded.add(row);
        io.unobserve(row);
        const title = row.querySelector<HTMLElement>('.work-title');
        const i = rows.indexOf(row);
        if (title) setTimeout(() => scramble(title, 850), i * 70 + 150);
        if (i === 0) {
          setTimeout(() => {
            if (!rows.some((r) => r.classList.contains('open'))) setOpen(row, true);
          }, 1100);
        }
      });
    },
    { threshold: 0.3 }
  );
  rows.forEach((row) => io.observe(row));
</script>

---
import { projects } from '../data/portfolio.js';

const marqueeFor = (title: string, tags: string[]) =>
  [title, ...tags].join('  ✦  ') + '  ✦  ';
---

<section id="projects">
  <div class="work-inner">
    <div class="section-header reveal">
      <span class="section-number">02</span>
      <h2 class="section-title">Selected work</h2>
      <span class="work-hint">index — {String(projects.length).padStart(2, '0')} entries</span>
    </div>

    <ul class="work-index">
      {projects.map(({ index, title, description, tags, url, nda }, i) => (
        <li class="work-row reveal" style={`transition-delay: ${i * 70}ms`}>
          <button
            class="work-head"
            aria-expanded="false"
            aria-controls={`work-panel-${index}`}
          >
            <span class="work-no">{index}</span>
            <span class="work-title">{title}</span>
            <span class="work-meta">
              {nda && <span class="work-nda">NDA</span>}
              <span class="work-toggle" aria-hidden="true">
                <span class="work-toggle-h"></span>
                <span class="work-toggle-v"></span>
              </span>
            </span>

            <span class="work-marquee" aria-hidden="true">
              <span class="work-marquee-track">
                {[0, 1, 2, 3].map(() => (
                  <span class="work-marquee-chunk">{marqueeFor(title, tags)}</span>
                ))}
              </span>
            </span>
          </button>

          <div class="work-panel" id={`work-panel-${index}`}>
            <div class="work-panel-clip">
              <div class="work-panel-inner">
                <p class="work-desc">{description}</p>
                <div class="work-aside">
                  <div class="work-tags">
                    {tags.map(tag => <span class="tag">{tag}</span>)}
                  </div>
                  {url && (
                    <a href={url} class="work-link" target="_blank" rel="noopener noreferrer">
                      Visit project <span class="work-link-arrow">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  #projects {
    padding: 6rem 5vw 5rem;
  }

  .work-hint {
    margin-left: auto;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ── Index list ── */
  .work-index {
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .work-row {
    border-top: 1px solid var(--border);
  }

  /* ── Row head ── */
  .work-head {
    position: relative;
    overflow: hidden;
    width: 100%;
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.6rem 0.25rem;
    background: none;
    border: none;
    color: inherit;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }

  .work-no {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    transition: color 0.3s;
  }

  .work-title {
    font-family: 'Cormorant Garant', serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 4.2vw, 3.4rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    align-self: center;
  }

  .work-nda {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }

  /* plus → minus toggle */
  .work-toggle {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .work-toggle-h,
  .work-toggle-v {
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--ink-2);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s;
  }
  .work-toggle-h { width: 14px; height: 1.5px; }
  .work-toggle-v { width: 1.5px; height: 14px; }
  .work-row.open .work-toggle-v { transform: rotate(90deg) scaleY(0); }
  .work-row.open .work-toggle-h { background: var(--accent); }

  /* ── Hover: title shift ── */
  @media (hover: hover) {
    .work-head:hover .work-title {
      transform: translateX(1.25rem);
    }
    .work-head:hover .work-no { color: var(--accent); }
  }
  .work-row.open .work-title { color: var(--accent); }
  .work-row.open .work-no { color: var(--accent); }

  /* ── Marquee band (hover) ── */
  .work-marquee {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--accent);
    transform: translateY(101%);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  @media (hover: hover) {
    .work-head:hover .work-marquee { transform: translateY(0); }
    .work-row.open .work-head:hover .work-marquee { transform: translateY(101%); }
  }

  .work-marquee-track {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
    animation: work-marquee-scroll 14s linear infinite;
  }
  .work-marquee-chunk {
    font-family: 'Cormorant Garant', serif;
    font-style: italic;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    color: var(--bg);
    padding-right: 0.5em;
  }

  @keyframes work-marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Expanding panel ── */
  .work-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-row.open .work-panel {
    grid-template-rows: 1fr;
  }
  .work-panel-clip {
    overflow: hidden;
    min-height: 0;
  }

  .work-panel-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 2.5rem;
    padding: 0.5rem 0.25rem 2.25rem 4.5rem;
  }

  .work-desc {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.8;
    max-width: 58ch;
  }

  .work-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .work-link {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2rem;
    transition: color 0.2s;
  }
  .work-link:hover { color: var(--accent); }
  .work-link-arrow { color: var(--accent); }

  /* stagger panel children on open */
  .work-desc,
  .work-aside {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .work-row.open .work-desc {
    opacity: 1;
    transform: none;
    transition-delay: 0.18s;
  }
  .work-row.open .work-aside {
    opacity: 1;
    transform: none;
    transition-delay: 0.28s;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .work-marquee-track { animation: none; }
    .work-marquee,
    .work-panel,
    .work-title,
    .work-desc,
    .work-aside { transition: none; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #projects { padding: 4rem 5vw 3rem; }
    .work-hint { display: none; }
    .work-head {
      grid-template-columns: 2.5rem 1fr auto;
      gap: 0.85rem;
      padding: 1.25rem 0;
    }
    .work-title { font-size: clamp(1.35rem, 6.5vw, 1.7rem); }
    .work-panel-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0.25rem 0 1.75rem 2.5rem;
    }
    .work-marquee { display: none; }
  }
</style>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.work-row'));

  function setOpen(row: HTMLElement, open: boolean) {
    row.classList.toggle('open', open);
    row.querySelector('.work-head')?.setAttribute('aria-expanded', String(open));
  }

  rows.forEach((row) => {
    row.querySelector<HTMLButtonElement>('.work-head')?.addEventListener('click', () => {
      const wasOpen = row.classList.contains('open');
      rows.forEach((r) => setOpen(r, false));
      if (!wasOpen) setOpen(row, true);
    });
  });

  /* Open the first entry once the list has revealed, as an invitation */
  const first = rows[0];
  if (first) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          setTimeout(() => {
            if (!rows.some((r) => r.classList.contains('open'))) setOpen(first, true);
          }, 650);
        }
      },
      { threshold: 0.4 }
    );
    io.observe(first);
  }
</script>

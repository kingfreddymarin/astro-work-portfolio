---
import { projects as allProjects } from '../data/portfolio.js';

const projects = allProjects.filter((p) => !p.hidden);

const marqueeFor = (title: string, tags: string[]) =>
  [title, ...tags].join('  ✦  ') + '  ✦  ';

type Project = (typeof projects)[number];
const statusOf = (p: Project) => (p.url ? 'LIVE' : p.nda ? 'CLASSIFIED' : 'ARCHIVE');
---

<section id="projects">
  <div class="work-inner">
    <div class="section-header reveal">
      <span class="section-number">03</span>
      <h2 class="section-title">Selected work</h2>
      <span class="work-telemetry" aria-hidden="true">
        <span id="work-tele-text">INDEX // {String(projects.length).padStart(2, '0')} ENTRIES</span><span class="work-caret"></span>
      </span>
    </div>

    <ul class="work-index">
      {projects.map((p, i) => {
        const { index, title, description, tags, url, story, metric, client } = p;
        const status = statusOf(p);
        // Status word the "card" returns for this entry.
        const sw = url ? '90 00' : p.nda ? '6F 00' : '90 00';
        const swMeaning = url ? 'OK' : p.nda ? 'NDA' : 'OK';
        return (
          <li
            class="work-row reveal"
            style={`transition-delay: ${i * 70}ms`}
            data-title={title}
            data-index={index}
            data-status={status}
            data-stack={String(tags.length).padStart(2, '0')}
          >
            <button
              class="work-head"
              aria-expanded="false"
              aria-controls={`work-panel-${index}`}
            >
              <span class="work-no">{index}</span>
              <span class="work-title" data-text={title}>{title}</span>
              <span class="work-meta">
                <span class={`work-status is-${status.toLowerCase()}`}>
                  <span class="ws-dot"></span>
                  <span class="ws-label">{status}</span>
                </span>
                <span class="work-toggle" aria-hidden="true">
                  <span class="work-toggle-h"></span>
                  <span class="work-toggle-v"></span>
                </span>
              </span>
            </button>

            <div class="work-panel" id={`work-panel-${index}`}>
              <div class="work-panel-clip">
                <div class="work-banner" aria-hidden="true">
                  <span class="work-banner-track">
                    {[0, 1, 2, 3].map(() => (
                      <span class="work-banner-chunk">{marqueeFor(title, tags)}</span>
                    ))}
                  </span>
                </div>
                <div class="work-panel-inner">
                  <!-- APDU transaction trace -->
                  <div class="apdu" aria-hidden="true">
                    <div class="apdu-trace" data-sw={sw}>
                      <span class="apdu-row apdu-tx"><i class="apdu-dir">&gt;&gt;</i> SELECT CASE <b>[{index}]</b></span>
                      <span class="apdu-row apdu-proc"><i class="apdu-dir">··</i> CARD PROCESSING<span class="apdu-dots"></span></span>
                      <span class="apdu-row apdu-rx"><i class="apdu-dir">&lt;&lt;</i> <span class="apdu-sw" data-text={sw}>{sw}</span> <span class="apdu-sw-meaning">{swMeaning}</span></span>
                    </div>
                  </div>

                  <div class="case" data-nda={p.nda ? '1' : '0'}>
                    <div class="case-metric">
                      <span class="cm-value" data-text={metric.value}>{metric.value}</span>
                      <span class="cm-label">{metric.label}</span>
                      {client && <span class="cm-client">{client}</span>}
                    </div>

                    <ol class="case-flow">
                      <li class="case-step" style="--step:0">
                        <span class="cs-head">
                          <span class="cs-sw" data-text="6A 80">6A 80</span>
                          <span class="cs-tag">PROBLEM</span>
                        </span>
                        <p class="cs-text">{story.problem}</p>
                      </li>
                      <li class="case-step" style="--step:1">
                        <span class="cs-head">
                          <span class="cs-sw" data-text="80 CA">80 CA</span>
                          <span class="cs-tag">APPROACH</span>
                        </span>
                        <p class="cs-text">{story.approach}</p>
                      </li>
                      <li class="case-step is-ok" style="--step:2">
                        <span class="cs-head">
                          <span class="cs-sw" data-text="90 00">90 00</span>
                          <span class="cs-tag">OUTCOME</span>
                        </span>
                        <p class="cs-text">{story.outcome}</p>
                      </li>
                    </ol>

                    <div class="case-foot">
                      <div class="case-stack">
                        <span class="work-label">STACK [{String(tags.length).padStart(2, '0')}] //</span>
                        <div class="work-tags">
                          {tags.map(tag => <span class="tag">{tag}</span>)}
                        </div>
                      </div>
                      {url ? (
                        <a href={url} class="work-link" target="_blank" rel="noopener noreferrer">
                          Access project <span class="work-link-arrow">↗</span>
                        </a>
                      ) : (
                        <span class="case-nda">
                          <span class="case-nda-sw">6F 00</span> Confidential — references on request
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  #projects {
    padding: 6rem 5vw 5rem;
    background-image:
      linear-gradient(rgba(240, 239, 233, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 239, 233, 0.028) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  /* ── Telemetry readout ── */
  .work-telemetry {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    max-width: min(64ch, 40vw);
  }
  .work-caret {
    width: 6px;
    height: 11px;
    background: var(--accent);
    flex-shrink: 0;
    animation: work-caret-blink 1.1s step-end infinite;
  }
  @keyframes work-caret-blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  /* ── Index list + corner brackets ── */
  .work-index {
    list-style: none;
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  .work-index::before,
  .work-index::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }
  .work-index::before {
    top: -1px;
    left: 0;
    border-top: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
  }
  .work-index::after {
    bottom: -1px;
    right: 0;
    border-bottom: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
  }

  .work-row {
    border-top: 1px solid var(--border);
  }

  /* ── Row head ── */
  .work-head {
    position: relative;
    overflow: hidden;
    width: 100%;
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.6rem 0.25rem;
    background: none;
    border: none;
    color: inherit;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }

  .work-no {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    transition: color 0.3s;
  }
  .work-no::before { content: '['; color: var(--ink-3); }
  .work-no::after  { content: ']'; color: var(--ink-3); }

  .work-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 4.2vw, 3.4rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    align-self: center;
  }

  /* ── Status readout ── */
  .work-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }
  .ws-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink-3);
    flex-shrink: 0;
  }
  .work-status.is-live { color: var(--accent); }
  .work-status.is-live .ws-dot {
    background: var(--accent);
    box-shadow: 0 0 8px rgba(255, 194, 75, 0.7);
    animation: work-status-pulse 1.8s ease-in-out infinite;
  }
  .work-status.is-classified .ws-dot {
    background: transparent;
    border: 1px solid var(--ink-3);
  }
  @keyframes work-status-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  /* plus → minus toggle */
  .work-toggle {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .work-toggle-h,
  .work-toggle-v {
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--ink-2);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s;
  }
  .work-toggle-h { width: 14px; height: 1.5px; }
  .work-toggle-v { width: 1.5px; height: 14px; }
  .work-row.open .work-toggle-v { transform: rotate(90deg) scaleY(0); }
  .work-row.open .work-toggle-h { background: var(--accent); }

  /* ── Hover: title shift ── */
  @media (hover: hover) {
    .work-head:hover .work-title {
      transform: translateX(1.25rem);
    }
    .work-head:hover .work-no { color: var(--accent); }
  }
  .work-row.open .work-title { color: var(--accent); }
  .work-row.open .work-no { color: var(--accent); }

  /* ── Tech banner (inside the opened dossier) ── */
  .work-banner {
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--accent);
    /* collapsed until the row opens */
    height: 0;
    opacity: 0;
    transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
  }
  .work-row.open .work-banner {
    height: 2.6em;
    opacity: 1;
  }

  .work-banner-track {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
    animation: work-banner-scroll 26s linear infinite;
  }
  .work-banner-chunk {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(1.1rem, 2.4vw, 1.7rem);
    line-height: 2.6em;
    color: var(--bg);
    padding-right: 0.5em;
  }

  @keyframes work-banner-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Expanding panel ── */
  .work-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-row.open .work-panel {
    grid-template-rows: 1fr;
  }
  .work-panel-clip {
    overflow: hidden;
    min-height: 0;
  }

  .work-panel-inner {
    position: relative;
    display: block;
    padding: 0.75rem 1.25rem 2.25rem 4.5rem;
  }

  /* ── APDU transaction trace ── */
  .apdu {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    margin-bottom: 1.75rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px dashed var(--border);
  }
  .apdu-trace {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    align-items: center;
  }
  .apdu-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(4px);
  }
  .work-row.open .apdu-row {
    opacity: 1;
    transform: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .work-row.open .apdu-tx   { transition-delay: 0.05s; }
  .work-row.open .apdu-proc { transition-delay: 0.28s; }
  .work-row.open .apdu-rx   { transition-delay: 0.62s; }
  .apdu-dir { font-style: normal; color: var(--accent); opacity: 0.8; }
  .apdu-tx b { color: var(--ink-2); font-weight: 400; }
  .apdu-dots::after {
    content: '';
    animation: apdu-dots 1.2s steps(4, end) infinite;
  }
  @keyframes apdu-dots {
    0% { content: ''; } 25% { content: '.'; }
    50% { content: '..'; } 75% { content: '...'; }
  }
  .apdu-sw {
    color: var(--ink);
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 2px;
  }
  .apdu-trace[data-sw='90 00'] .apdu-sw {
    color: var(--accent);
    border-color: rgba(255, 194, 75, 0.45);
    box-shadow: 0 0 10px rgba(255, 194, 75, 0.18);
  }
  .apdu-trace[data-sw='6F 00'] .apdu-sw {
    color: var(--ink-2);
    border-style: dashed;
  }
  .apdu-sw-meaning { color: var(--ink-3); }

  /* ── Case study: Apple-keynote storytelling ── */
  .case {
    display: block;
    max-width: 70rem;
    margin: 0 auto;
  }

  /* Hero metric — the headline number, told big */
  .case-metric {
    text-align: center;
    margin: 1rem 0 4.5rem;
  }
  .cm-value {
    display: block;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(4.5rem, 17vw, 13rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--accent);
    opacity: 0;
    transform: translateY(18px) scale(0.96);
  }
  .work-row.open .cm-value {
    opacity: 1;
    transform: none;
    transition: opacity 0.6s ease 0.55s, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.55s;
  }
  .cm-label {
    display: block;
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 1.25rem auto 0;
    max-width: 32ch;
    opacity: 0;
  }
  .work-row.open .cm-label { opacity: 1; transition: opacity 0.6s ease 0.8s; }
  .cm-client {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 1.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }

  /* The Problem → Approach → Outcome flow — big sequential beats */
  .case-flow {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .case-step {
    position: relative;
    text-align: center;
    padding: 3.5rem 0;
    opacity: 0;
    transform: translateY(24px);
  }
  .case-step + .case-step { border-top: 1px solid var(--border); }
  .work-row.open .case-step {
    opacity: 1;
    transform: none;
    transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(0.95s + var(--step) * 0.22s);
  }
  .cs-head {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .cs-sw {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 2px;
  }
  .case-step.is-ok .cs-sw {
    color: var(--accent);
    border-color: rgba(255, 194, 75, 0.45);
    box-shadow: 0 0 10px rgba(255, 194, 75, 0.18);
  }
  .cs-tag {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--ink-3);
  }
  /* the story sentence, told in big editorial serif */
  .cs-text {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(1.5rem, 3.6vw, 2.9rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 24ch;
    margin: 0 auto;
  }
  .case-step.is-ok .cs-text {
    font-style: italic;
    color: var(--ink);
  }
  /* highlight the punch words in the outcome */
  .case-step.is-ok .cs-text b { color: var(--accent); font-style: normal; font-weight: 600; }

  .case-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: 2.5rem;
    border-top: 1px dashed var(--border);
  }
  .case-nda {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .case-nda-sw {
    color: var(--ink-2);
    border: 1px dashed var(--border);
    border-radius: 2px;
    padding: 0.1rem 0.35rem;
  }

  /* corner ticks framing the open dossier */
  .work-panel-inner::before,
  .work-panel-inner::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    opacity: 0.65;
  }
  .work-panel-inner::before {
    top: 0;
    left: 3.25rem;
    border-top: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
  }
  .work-panel-inner::after {
    bottom: 1.25rem;
    right: 0;
    border-bottom: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
  }

  .work-label {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .work-link {
    margin-top: 1.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.2rem;
    transition: color 0.2s;
  }
  .work-link:hover { color: var(--accent); }
  .work-link-arrow { color: var(--accent); }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .work-banner-track { animation: none; }
    .work-caret { animation: none; }
    .work-status.is-live .ws-dot { animation: none; }
    .apdu-dots::after { animation: none; content: '...'; }
    .work-banner,
    .work-panel,
    .work-title { transition: none; }
    .apdu-row,
    .cm-value,
    .cm-label,
    .case-step {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .case-flow::before { background-size: 100% 100% !important; transition: none; }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #projects { padding: 4rem 5vw 3rem; background-size: 40px 40px; }
    .work-telemetry { display: none; }
    .work-head {
      grid-template-columns: 2.5rem 1fr auto;
      gap: 0.85rem;
      padding: 1.25rem 0;
    }
    .work-title { font-size: clamp(1.35rem, 6.5vw, 1.7rem); }
    .work-meta { gap: 0.75rem; }
    .ws-label { display: none; }
    .work-panel-inner {
      padding: 0.5rem 0 1.75rem 0;
    }
    .work-panel-inner::before { left: 0.25rem; }
    .work-panel-inner::after { right: 0.25rem; }
    .apdu-trace { font-size: 9px; gap: 0.35rem 1rem; }
    .case-metric { margin: 0.5rem 0 3rem; }
    .case-step { padding: 2.5rem 0; }
    .cs-text { max-width: 18ch; }
    .case-foot { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.work-row'));
  const teleText = document.getElementById('work-tele-text');
  const teleDefault = teleText?.textContent ?? '';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Text decode scramble ── */
  const GLYPHS = 'ABCDEFGHKMNPRSTUVWXYZ0123456789#/<>*';
  const scrambling = new WeakSet<HTMLElement>();

  function scramble(el: HTMLElement, duration = 700) {
    const target = el.dataset.text ?? el.textContent ?? '';
    if (reducedMotion || scrambling.has(el)) return;
    scrambling.add(el);
    const start = performance.now();

    function frame(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const settled = Math.floor(t * target.length);
      let out = target.slice(0, settled);
      for (let i = settled; i < target.length; i++) {
        const ch = target[i];
        out += ch === ' ' ? ' ' : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      }
      el.textContent = out;
      if (t < 1) requestAnimationFrame(frame);
      else {
        el.textContent = target;
        scrambling.delete(el);
      }
    }
    requestAnimationFrame(frame);
  }

  /* ── Hex scramble for APDU status words ── */
  const HEX = '0123456789ABCDEF';
  function hexScramble(el: HTMLElement, duration = 500) {
    const target = el.dataset.text ?? el.textContent ?? '';
    if (reducedMotion) return;
    const start = performance.now();
    function frame(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const settled = Math.floor(t * target.length);
      let out = '';
      for (let i = 0; i < target.length; i++) {
        const ch = target[i];
        if (ch === ' ') out += ' ';
        else if (i < settled) out += ch;
        else out += HEX[Math.floor(Math.random() * 16)];
      }
      el.textContent = out;
      if (t < 1) requestAnimationFrame(frame);
      else el.textContent = target;
    }
    requestAnimationFrame(frame);
  }

  /* ── Run the APDU "transaction" when a case opens ── */
  const animated = new WeakSet<HTMLElement>();
  function animateCase(row: HTMLElement) {
    if (reducedMotion) return;
    // re-arm so reopening replays the trace
    animated.add(row);
    const apduSw = row.querySelector<HTMLElement>('.apdu-sw');
    if (apduSw) setTimeout(() => hexScramble(apduSw, 480), 660);
    const cm = row.querySelector<HTMLElement>('.cm-value');
    if (cm) setTimeout(() => scramble(cm, 720), 580);
    row.querySelectorAll<HTMLElement>('.cs-sw').forEach((el, i) => {
      setTimeout(() => hexScramble(el, 440), 1050 + i * 220);
    });
  }

  /* ── Telemetry readout ── */
  function readout(row: HTMLElement) {
    if (!teleText) return;
    const { index, title, stack, status } = row.dataset;
    teleText.textContent = `${index} // ${title?.toUpperCase()} // STACK[${stack}] // ${status}`;
  }
  function readoutReset() {
    if (teleText) teleText.textContent = teleDefault;
  }

  /* ── Accordion ── */
  function setOpen(row: HTMLElement, open: boolean) {
    row.classList.toggle('open', open);
    row.querySelector('.work-head')?.setAttribute('aria-expanded', String(open));
    if (open) animateCase(row);
  }

  rows.forEach((row) => {
    const head = row.querySelector<HTMLButtonElement>('.work-head');
    const title = row.querySelector<HTMLElement>('.work-title');

    head?.addEventListener('click', () => {
      // Clicking a project zooms into its immersive case scene.
      const index = row.dataset.index;
      if (index) window.dispatchEvent(new CustomEvent('case:open', { detail: { index } }));
    });

    head?.addEventListener('mouseenter', () => {
      readout(row);
    });
  });

  document.querySelector('.work-index')?.addEventListener('mouseleave', readoutReset);

  /* ── Number shortcut: on the Work view, type a 2-digit index (01–99) to open ── */
  function openByIndex(idx: string) {
    const row = rows.find((r) => r.dataset.index === idx);
    if (!row) return;
    window.dispatchEvent(new CustomEvent('case:open', { detail: { index: idx } }));
  }

  let digitBuf = '';
  let digitTimer = 0;
  window.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (document.querySelector('.view.is-active')?.getAttribute('data-view') !== 'work') return;
    if (document.body.classList.contains('menu-open')) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA'
      || t.tagName === 'SELECT' || t.isContentEditable)) return;
    if (!/^[0-9]$/.test(e.key)) return;

    e.preventDefault();
    clearTimeout(digitTimer);
    digitBuf += e.key;
    if (digitBuf.length === 2) {
      openByIndex(digitBuf);
      digitBuf = '';
    } else {
      // wait for the second digit; reset if it doesn't arrive
      digitTimer = window.setTimeout(() => { digitBuf = ''; }, 1000);
    }
  });

  /* ── Decode titles on first reveal, then open the first entry ── */
  const decoded = new WeakSet<HTMLElement>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const row = entry.target as HTMLElement;
        if (decoded.has(row)) return;
        decoded.add(row);
        io.unobserve(row);
        const title = row.querySelector<HTMLElement>('.work-title');
        const i = rows.indexOf(row);
        if (title) setTimeout(() => scramble(title, 850), i * 70 + 150);
      });
    },
    { threshold: 0.3 }
  );
  rows.forEach((row) => io.observe(row));
</script>

---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="alert-overlay" id={id}>
  <div class="alert-box">
    <h4 class="alert-title" id={`${id}-title`}>Confirm Action</h4>
    <p class="alert-desc" id={`${id}-desc`}>Are you sure you want to perform this operation?</p>
    <div class="alert-actions">
      <button class="btn btn-ghost" id={`${id}-cancel`} type="button">CANCEL</button>
      <button class="btn btn-primary" id={`${id}-confirm`} type="button" style="background: var(--live); color: #0E0F11;">PROCEED</button>
    </div>
  </div>
</div>
